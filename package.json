{
  "name": "pallet-studio",
  "productName": "K-Core Studio",
  "version": "1.4.8",
  "description": "K-Core Studio — Hệ thống Quản trị Kỹ thuật, Tự động hóa & Thị giác máy",
  "main": "src/main.js",
  "scripts": {
    "postinstall": "node scripts/copy-libs.js",
    "test": "node tests/fs-safe.test.js && node tests/core.test.js && node tests/e2e-p1.test.js && node tests/publish.test.js && node tests/e2e-p2.test.js && node tests/admin.test.js && node tests/e2e-p3.test.js && node tests/auth.test.js",
    "start": "electron .",
    "optiflow": "electron optiflow-vision/frontend/electron/main.cjs",
    "optiflow:build": "vite build --config optiflow-vision/frontend/vite.config.ts",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "three": "0.128.0",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "com.kha.studio",
    "productName": "K-Core Studio",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  }
}
