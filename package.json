{
  "name": "pallet-studio",
  "productName": "Kha Studio",
  "version": "1.3.1",
  "description": "Bộ công cụ cá nhân - Kha.nm",
  "main": "src/main.js",
  "scripts": {
    "postinstall": "node scripts/copy-libs.js",
    "test": "node tests/fs-safe.test.js && node tests/core.test.js && node tests/e2e-p1.test.js && node tests/publish.test.js && node tests/e2e-p2.test.js && node tests/admin.test.js && node tests/e2e-p3.test.js && node tests/auth.test.js",
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "three": "0.128.0"
  },
  "build": {
    "appId": "com.kha.studio",
    "productName": "Kha Studio",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
