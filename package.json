{
  "name": "pallet-studio",
  "productName": "Kha Studio",
  "version": "1.1.0",
  "description": "Bộ công cụ cá nhân - Kha.nm",
  "main": "src/main.js",
  "scripts": {
    "postinstall": "node scripts/copy-libs.js",
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "three": "0.128.0"
  },
  "build": {
    "appId": "com.kha.studio",
    "productName": "Kha Studio",
    "files": ["src/**/*", "package.json"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
