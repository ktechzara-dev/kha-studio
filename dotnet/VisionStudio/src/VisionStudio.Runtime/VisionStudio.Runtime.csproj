<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>VisionStudio.Runtime</RootNamespace>
    <AssemblyName>VisionStudio.Runtime</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VisionStudio.Core\VisionStudio.Core.csproj" />
    <ProjectReference Include="..\VisionStudio.Imaging\VisionStudio.Imaging.csproj" />
    <ProjectReference Include="..\VisionStudio.Matching\VisionStudio.Matching.csproj" />
    <ProjectReference Include="..\VisionStudio.DeepLearning\VisionStudio.DeepLearning.csproj" />
    <ProjectReference Include="..\VisionStudio.Scripting\VisionStudio.Scripting.csproj" />
    <ProjectReference Include="..\VisionStudio.Connectivity\VisionStudio.Connectivity.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

</Project>
