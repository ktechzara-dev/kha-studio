<Window x:Class="VisionStudio.App.Controls.QuickBuildWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚡ Quick Build Wizards - Kho Kịch Bản &amp; Ảnh Kiểm Tra Mẫu Công Nghiệp"
        Height="760" Width="1020"
        WindowStartupLocation="CenterScreen"
        Background="#121620" Foreground="#E2E8F0"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="KsBgSurface" Color="#1A202C"/>
        <SolidColorBrush x:Key="KsBgCard" Color="#232C3D"/>
        <SolidColorBrush x:Key="KsBorder" Color="#334155"/>
        <SolidColorBrush x:Key="KsAccent" Color="#00D2FF"/>
        <SolidColorBrush x:Key="KsAccentGlow" Color="#38BDF8"/>
        <SolidColorBrush x:Key="KsTextDim" Color="#94A3B8"/>
        <SolidColorBrush x:Key="KsGreen" Color="#22C55E"/>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- HEADER -->
            <RowDefinition Height="Auto"/>
            <!-- WIZARDS LIST -->
            <RowDefinition Height="*"/>
            <!-- FOOTER -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="⚡ THƯ VIỆN KỊCH BẢN &amp; DỮ LIỆU ẢNH KIỂM TRA MẪU (8 CHUYÊN ĐỀ)" FontWeight="Bold" FontSize="18" Foreground="{StaticResource KsAccentGlow}"/>
            <TextBlock Text="Chọn một kịch bản ứng dụng công nghiệp để tự động nạp cấu trúc Pipeline hoàn chỉnh cùng tệp ảnh test tương ứng:" FontSize="12" Foreground="{StaticResource KsTextDim}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- WIZARD CARDS -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- WIZARD 1: MEASURE DISTANCE & SPC -->
                <Border Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📐" FontSize="34" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="1. Đo Lường Đường Kính Trục Bậc Sub-pixel &amp; SPC" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                <Border Background="#0F766E" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="📷 01_stepped_shaft_dimension.png" FontSize="10" Foreground="#5EEAD4" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Pipeline: CameraGrab ➔ Grayscale ➔ Gaussian Filter ➔ 1D Caliper ➔ SPC Process Capability (Cp/Cpk)" FontSize="11.5" Foreground="{StaticResource KsAccent}" Margin="0,3,0,3"/>
                            <TextBlock Text="Đo chiều rộng &amp; đường kính trục phôi cơ khí với độ chính xác dưới 0.1 px, tự động tính năng lực quá trình Cp/Cpk và dung sai kỹ thuật." FontSize="11" Foreground="{StaticResource KsTextDim}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Nạp Kịch Bản Mẫu ➔" Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="10,8" VerticalAlignment="Center" Cursor="Hand" Click="BtnBuildMeasure_Click"/>
                    </Grid>
                </Border>

                <!-- WIZARD 2: READ CODE & GRADE -->
                <Border Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🏷️" FontSize="34" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="2. Đọc Mã Vạch Công Nghiệp &amp; Chấm Điểm Chuẩn ISO/IEC" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                <Border Background="#0F766E" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="📷 02_industrial_codes_label.png" FontSize="10" Foreground="#5EEAD4" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Pipeline: CameraGrab ➔ Grayscale ➔ BarcodeReader (Auto) ➔ CodeQualityGrading ➔ Judge (Pass/Fail)" FontSize="11.5" Foreground="{StaticResource KsAccent}" Margin="0,3,0,3"/>
                            <TextBlock Text="Đọc giải mã nhãn đa chuẩn (DataMatrix 2D, QR Code, Code128 1D) và đánh giá chất lượng in ấn ISO/IEC 15415/15416 (Grade A-D)." FontSize="11" Foreground="{StaticResource KsTextDim}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Nạp Kịch Bản Mẫu ➔" Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="10,8" VerticalAlignment="Center" Cursor="Hand" Click="BtnBuildCode_Click"/>
                    </Grid>
                </Border>

                <!-- WIZARD 3: PCB SURFACE DEFECT -->
                <Border Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="34" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="3. Kiểm Tra Khuyết Tật Bề Mặt, Đứt Mạch &amp; Ngắn Mạch PCB" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                <Border Background="#0F766E" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="📷 03_pcb_circuit_defect.png" FontSize="10" Foreground="#5EEAD4" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Pipeline: CameraGrab ➔ Grayscale ➔ Filter Sharpen ➔ Threshold (Otsu) ➔ Blob Analysis" FontSize="11.5" Foreground="{StaticResource KsAccent}" Margin="0,3,0,3"/>
                            <TextBlock Text="Làm sắc nét đường mạch in vi điện tử, nhị phân phân tách nền và phát hiện các hạt khuyết tật, cầu chì ngắn mạch hoặc đứt gãy trace." FontSize="11" Foreground="{StaticResource KsTextDim}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Nạp Kịch Bản Mẫu ➔" Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="10,8" VerticalAlignment="Center" Cursor="Hand" Click="BtnBuildDefect_Click"/>
                    </Grid>
                </Border>

                <!-- WIZARD 4: LOCATE & PICK ROBOT GUIDANCE -->
                <Border Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🎯" FontSize="34" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="4. Định Vị Chi Tiết Bánh Răng &amp; Điều Khiển Tay Gắp Robot" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                <Border Background="#0F766E" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="📷 04_gear_part_alignment.png" FontSize="10" Foreground="#5EEAD4" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Pipeline: CameraGrab ➔ Grayscale ➔ Threshold ➔ Blob Analysis (Centroid) ➔ Pattern Align (Delta X/Y)" FontSize="11.5" Foreground="{StaticResource KsAccent}" Margin="0,3,0,3"/>
                            <TextBlock Text="Xác định tọa độ tâm hình học chi tiết xoay 360°, tính toán sai số Delta X, Delta Y và góc lệch để xuất lệnh bù sai lệch cho Robot PLC." FontSize="11" Foreground="{StaticResource KsTextDim}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Nạp Kịch Bản Mẫu ➔" Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="10,8" VerticalAlignment="Center" Cursor="Hand" Click="BtnBuildLocate_Click"/>
                    </Grid>
                </Border>

                <!-- WIZARD 5: PHARMACEUTICAL PILL COUNTING -->
                <Border Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="💊" FontSize="34" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="5. Đếm Số Lượng Viên Thuốc &amp; Phân Tích Hình Dạng Hạt Blob" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                <Border Background="#0F766E" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="📷 05_pharmaceutical_tablets.png" FontSize="10" Foreground="#5EEAD4" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Pipeline: CameraGrab ➔ Grayscale ➔ Threshold ➔ Morphology (Open) ➔ Blob Counting ➔ Judge (8 Viên)" FontSize="11.5" Foreground="{StaticResource KsAccent}" Margin="0,3,0,3"/>
                            <TextBlock Text="Tách rời các hạt tiếp xúc, đếm chính xác số lượng viên nén trên vỉ dược phẩm, đo độ tròn và cảnh báo khi có viên bị sứt mẻ/vỡ." FontSize="11" Foreground="{StaticResource KsTextDim}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Nạp Kịch Bản Mẫu ➔" Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="10,8" VerticalAlignment="Center" Cursor="Hand" Click="BtnBuildPills_Click"/>
                    </Grid>
                </Border>

                <!-- WIZARD 6: COLOR SORTING & PRESENCE -->
                <Border Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🎨" FontSize="34" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="6. Phân Loại Màu Sắc Nắp Chai &amp; Kiểm Tra Hiện Diện" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                <Border Background="#0F766E" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="📷 06_colored_bottle_caps.png" FontSize="10" Foreground="#5EEAD4" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Pipeline: CameraGrab ➔ Crop ROI ➔ ColorCheck (CIE Lab ΔE) ➔ Presence / Absence Check" FontSize="11.5" Foreground="{StaticResource KsAccent}" Margin="0,3,0,3"/>
                            <TextBlock Text="Đo khoảng cách sắc độ Delta E so với màu tham chiếu, kiểm tra thiếu nắp chai hoặc lắp sai nắp màu trên dây chuyền đóng gói." FontSize="11" Foreground="{StaticResource KsTextDim}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Nạp Kịch Bản Mẫu ➔" Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="10,8" VerticalAlignment="Center" Cursor="Hand" Click="BtnBuildColor_Click"/>
                    </Grid>
                </Border>

                <!-- WIZARD 7: POLAR UNWRAP & SEAL RING -->
                <Border Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="⭕" FontSize="34" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="7. Trải Phẳng Toạ Độ Cực Gioăng Cao Su O-Ring &amp; Đo Độ Dày" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                <Border Background="#0F766E" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="📷 07_circular_seal_ring.png" FontSize="10" Foreground="#5EEAD4" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Pipeline: CameraGrab ➔ Grayscale ➔ Polar Unwrap (360°) ➔ Gaussian ➔ Caliper Tool" FontSize="11.5" Foreground="{StaticResource KsAccent}" Margin="0,3,0,3"/>
                            <TextBlock Text="Trải phẳng hình tròn 360 độ thành băng chữ nhật phẳng để quét thước đo Caliper liên tục, phát hiện vết xước rách xuyên tâm trên gioăng làm kín." FontSize="11" Foreground="{StaticResource KsTextDim}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Nạp Kịch Bản Mẫu ➔" Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="10,8" VerticalAlignment="Center" Cursor="Hand" Click="BtnBuildPolar_Click"/>
                    </Grid>
                </Border>

                <!-- WIZARD 8: OCR EXPIRY DATE -->
                <Border Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔤" FontSize="34" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="8. Nhận Dạng Ký Tự Quang Học Hạn Sử Dụng (OCR / OCV)" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                <Border Background="#0F766E" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="📷 08_food_pack_expiry_date.png" FontSize="10" Foreground="#5EEAD4" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Pipeline: CameraGrab ➔ Grayscale ➔ Filter Sharpen ➔ Trainable OCR/OCV (EXP: 2028-12-31)" FontSize="11.5" Foreground="{StaticResource KsAccent}" Margin="0,3,0,3"/>
                            <TextBlock Text="Đọc ký tự in phun công nghiệp mã ngày sản xuất, hạn sử dụng và số lô hàng thực phẩm, đối chiếu chuỗi ký tự theo chuẩn xác thực OCV." FontSize="11" Foreground="{StaticResource KsTextDim}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Nạp Kịch Bản Mẫu ➔" Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="10,8" VerticalAlignment="Center" Cursor="Hand" Click="BtnBuildOcr_Click"/>
                    </Grid>
                </Border>

                <!-- WIZARD 9: CARTON & CPM COUNTER DEEP LEARNING -->
                <Border Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📦" FontSize="34" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="9. Đếm Thùng &amp; Đo Tốc Độ Thùng/Phút (AI Conveyor CPM)" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                <Border Background="#1E3A8A" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="🎬 09_conveyor_boxes_flow.avi" FontSize="10" Foreground="#93C5FD" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Pipeline: VideoFile ➔ DeepLearning CartonCounter ➔ Judge (Tốc độ CPM)" FontSize="11.5" Foreground="{StaticResource KsAccent}" Margin="0,3,0,3"/>
                            <TextBlock Text="Nhận diện thùng carton / kiện hàng trên băng chuyền từ video bằng Deep Learning, theo dõi quỹ đạo (Centroid MOT Tracker), đếm số lượng qua vạch ảo và tính năng suất Thùng/Phút (CPM) theo thời gian thực." FontSize="11" Foreground="{StaticResource KsTextDim}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Nạp Kịch Bản Mẫu ➔" Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="10,8" VerticalAlignment="Center" Cursor="Hand" Click="BtnBuildCartonCounter_Click"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button Content="📂 Thư Mục Ảnh Mẫu (.png)" Padding="12,6" Background="#1E293B" Foreground="#38BDF8" BorderBrush="{StaticResource KsBorder}" FontWeight="SemiBold" Cursor="Hand" Click="BtnOpenImagesFolder_Click"/>
                <Button Content="🎬 Thư Mục Video Mẫu (.avi)" Padding="12,6" Margin="8,0,0,0" Background="#1E293B" Foreground="#38BDF8" BorderBrush="{StaticResource KsBorder}" FontWeight="SemiBold" Cursor="Hand" Click="BtnOpenVideosFolder_Click"/>
                <Button Content="📁 Thư Mục Kịch Bản (.vspipe)" Padding="12,6" Margin="8,0,0,0" Background="#1E293B" Foreground="#38BDF8" BorderBrush="{StaticResource KsBorder}" FontWeight="SemiBold" Cursor="Hand" Click="BtnOpenPipelinesFolder_Click"/>
            </StackPanel>
            <Button Content="Đóng" Width="100" Padding="10,6" Background="#232C3D" Foreground="White" BorderBrush="{StaticResource KsBorder}" HorizontalAlignment="Right" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
