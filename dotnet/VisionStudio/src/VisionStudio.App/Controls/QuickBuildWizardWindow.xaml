<Window x:Class="VisionStudio.App.Controls.QuickBuildWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚡ Quick Build Wizards - Trình Hướng Dẫn Thiết Lập Pipeline Nhanh"
        Height="680" Width="980"
        WindowStartupLocation="CenterScreen"
        Background="#121620" Foreground="#E2E8F0"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="KsBgSurface" Color="#1A202C"/>
        <SolidColorBrush x:Key="KsBgCard" Color="#232C3D"/>
        <SolidColorBrush x:Key="KsBorder" Color="#334155"/>
        <SolidColorBrush x:Key="KsAccent" Color="#00D2FF"/>
        <SolidColorBrush x:Key="KsAccentGlow" Color="#38BDF8"/>
        <SolidColorBrush x:Key="KsTextDim" Color="#94A3B8"/>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- HEADER -->
            <RowDefinition Height="Auto"/>
            <!-- WIZARDS LIST -->
            <RowDefinition Height="*"/>
            <!-- FOOTER -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="⚡ GUIDED QUICK-BUILD WIZARDS" FontWeight="Bold" FontSize="18" Foreground="{StaticResource KsAccentGlow}"/>
            <TextBlock Text="Chọn một kịch bản ứng dụng công nghiệp để tự động khởi tạo cấu trúc Pipeline DAG hoàn chỉnh với các tham số tối ưu:" FontSize="12" Foreground="{StaticResource KsTextDim}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- WIZARD CARDS -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- WIZARD 1: PRESENCE CHECK -->
                <Border Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📦" FontSize="36" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                            <TextBlock Text="1. Presence / Absence Check (Kiểm tra Linh kiện Có/Không)" FontWeight="Bold" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Pipeline: ImageAcquisition ➔ Binarize (Otsu) ➔ BlobAnalyzer ➔ LogicVerdict" FontSize="12" Foreground="{StaticResource KsAccent}" Margin="0,3,0,3"/>
                            <TextBlock Text="Phù hợp kiểm tra nắp chai, nhãn mác, gioăng cao su, thiếu ốc vít hoặc linh kiện trên khay." FontSize="11" Foreground="{StaticResource KsTextDim}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Tạo Pipeline Này ➔" Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="12,8" VerticalAlignment="Center" Cursor="Hand" Click="BtnBuildPresence_Click"/>
                    </Grid>
                </Border>

                <!-- WIZARD 2: MEASURE DISTANCE -->
                <Border Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📐" FontSize="36" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                            <TextBlock Text="2. Measure Distance &amp; Diameter (Đo Lường Kích Thước Sub-pixel)" FontWeight="Bold" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Pipeline: ImageAcquisition ➔ 1D Caliper ➔ DimensionMeasure ➔ SPC Capability" FontSize="12" Foreground="{StaticResource KsAccent}" Margin="0,3,0,3"/>
                            <TextBlock Text="Đo chiều rộng khe hở, đường kính vòng bi, khoảng cách giữa các chân pin IC độ chính xác &lt; 0.1 px." FontSize="11" Foreground="{StaticResource KsTextDim}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Tạo Pipeline Này ➔" Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="12,8" VerticalAlignment="Center" Cursor="Hand" Click="BtnBuildMeasure_Click"/>
                    </Grid>
                </Border>

                <!-- WIZARD 3: READ CODE & GRADE -->
                <Border Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🏷️" FontSize="36" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                            <TextBlock Text="3. Read Code &amp; ISO/IEC Quality Grading (Đọc &amp; Đánh Giá Mã Vạch)" FontWeight="Bold" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Pipeline: ImageAcquisition ➔ BarcodeReader ➔ CodeQualityGrading ➔ TraceabilityLog" FontSize="12" Foreground="{StaticResource KsAccent}" Margin="0,3,0,3"/>
                            <TextBlock Text="Đọc mã DataMatrix, QR, Barcode 1D và kiểm tra cấp chất lượng in đạt chuẩn ISO/IEC 15415 (Grade A-D)." FontSize="11" Foreground="{StaticResource KsTextDim}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Tạo Pipeline Này ➔" Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="12,8" VerticalAlignment="Center" Cursor="Hand" Click="BtnBuildCode_Click"/>
                    </Grid>
                </Border>

                <!-- WIZARD 4: LOCATE & PICK -->
                <Border Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🎯" FontSize="36" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                            <TextBlock Text="4. Locate &amp; Pick Robot Guidance (Định Vị Hình Học &amp; Điều Khiển Gắp)" FontWeight="Bold" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Pipeline: ImageAcquisition ➔ GeometricMatcher ➔ CoordinateFixture ➔ RobotPoseOutput" FontSize="12" Foreground="{StaticResource KsAccent}" Margin="0,3,0,3"/>
                            <TextBlock Text="Định vị chi tiết xoay 360°, tính toán toạ độ bù sai lệch offset (X, Y, Theta) xuất sang Robot PLC." FontSize="11" Foreground="{StaticResource KsTextDim}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Tạo Pipeline Này ➔" Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="12,8" VerticalAlignment="Center" Cursor="Hand" Click="BtnBuildLocate_Click"/>
                    </Grid>
                </Border>

                <!-- WIZARD 5: SURFACE DEFECT -->
                <Border Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="36" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                            <TextBlock Text="5. Surface Defect Inspection (Kiểm Tra Khuyết Tật Bề Mặt / Anomaly)" FontWeight="Bold" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Pipeline: ImageAcquisition ➔ DefectInspection ➔ RegionBoolean ➔ DefectReportTable" FontSize="12" Foreground="{StaticResource KsAccent}" Margin="0,3,0,3"/>
                            <TextBlock Text="Phát hiện vết xước, bọt khí, dị vật, vết ố trên bề mặt kim loại/kính/sơn bằng bản đồ sai khác." FontSize="11" Foreground="{StaticResource KsTextDim}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Tạo Pipeline Này ➔" Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="12,8" VerticalAlignment="Center" Cursor="Hand" Click="BtnBuildDefect_Click"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER -->
        <Border Grid.Row="2" Margin="0,14,0,0" HorizontalAlignment="Right">
            <Button Content="Đóng" Width="100" Padding="10,6" Background="#232C3D" Foreground="White" BorderBrush="{StaticResource KsBorder}" Click="BtnClose_Click"/>
        </Border>
    </Grid>
</Window>
