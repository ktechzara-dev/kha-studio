<Window x:Class="VisionStudio.App.Controls.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Command Palette (Ctrl+K)"
        Height="420" Width="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI" FontSize="13">
    <Border Background="#1A202C" BorderBrush="#00D2FF" BorderThickness="1.5" CornerRadius="10" Padding="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- SEARCH INPUT -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🔍" FontSize="18" VerticalAlignment="Center" Margin="4,0,10,0"/>
                <TextBox x:Name="TxtSearch" Grid.Column="1" Background="Transparent" Foreground="White" BorderThickness="0"
                         FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                         TextChanged="TxtSearch_TextChanged" KeyDown="TxtSearch_KeyDown"/>
                <Border Grid.Column="2" Background="#2D3748" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Text="ESC để đóng" FontSize="11" Foreground="#94A3B8"/>
                </Border>
            </Grid>

            <!-- DIVIDER -->
            <Border Grid.Row="1" Background="#334155" Margin="0,0,0,8"/>

            <!-- RESULTS LIST -->
            <ListBox x:Name="ListResults" Grid.Row="2" Background="Transparent" BorderThickness="0"
                     Foreground="White" SelectionMode="Single"
                     MouseDoubleClick="ListResults_MouseDoubleClick" KeyDown="ListResults_KeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,6" CornerRadius="6" Background="#232C3D" Margin="0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC"/>
                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#94A3B8"/>
                                </StackPanel>
                                <Border Grid.Column="2" Background="#2D3748" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#00D2FF" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- FOOTER HINTS -->
            <Border Grid.Row="3" Margin="0,8,0,0" Padding="4,0">
                <TextBlock Text="↑↓ di chuyển • Enter thực thi • Tìm kiếm công cụ, phím tắt, cửa sổ &amp; lệnh" FontSize="11" Foreground="#64748B"/>
            </Border>
        </Grid>
    </Border>
</Window>
