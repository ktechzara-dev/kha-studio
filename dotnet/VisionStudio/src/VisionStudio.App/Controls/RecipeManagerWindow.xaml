<Window x:Class="VisionStudio.App.Controls.RecipeManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Industrial Recipe Manager - Trình Quản Lý Công Thức Sản Phẩm (Jobs)"
        Height="780" Width="1180"
        MinHeight="550" MinWidth="850"
        Background="{StaticResource KsBgBase}" Foreground="{StaticResource KsText}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Action Bar -->
            <RowDefinition Height="50"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Status Bar -->
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📋 " FontSize="20" VerticalAlignment="Center"/>
                    <TextBlock Text="TRÌNH QUẢN LÝ CÔNG THỨC (RECIPE / JOBS)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource KsAccentGlow}" VerticalAlignment="Center"/>
                    <TextBlock Text=" | Runtime Product Switching, Overrides &amp; Tolerances" Foreground="{StaticResource KsTextDim}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnNewRecipe" Content="➕ Tạo Mới" Click="BtnNewRecipe_Click"
                            Style="{StaticResource KsSecondaryButton}" Margin="0,0,8,0" Padding="12,5"/>
                    <Button x:Name="BtnImportRecipe" Content="📂 Nhập (.vsrecipe)" Click="BtnImportRecipe_Click"
                            Style="{StaticResource KsSecondaryButton}" Margin="0,0,8,0" Padding="12,5"/>
                    <Button x:Name="BtnExportRecipe" Content="💾 Xuất (.vsrecipe)" Click="BtnExportRecipe_Click"
                            Style="{StaticResource KsSecondaryButton}" Margin="0,0,8,0" Padding="12,5"/>
                    <Button x:Name="BtnApplyRecipe" Content="🚀 Áp Dụng Cho Pipeline" Click="BtnApplyRecipe_Click"
                            Style="{StaticResource KsSuccessButton}" Padding="14,5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT SPLIT -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <!-- Left: Recipe List -->
                <ColumnDefinition Width="340" MinWidth="260"/>
                <ColumnDefinition Width="6"/>
                <!-- Right: Recipe Details & Editor -->
                <ColumnDefinition Width="*" MinWidth="480"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT RECIPE LIST -->
            <Border Grid.Column="0" Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="DANH SÁCH CÔNG THỨC (RECIPES)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource KsAccentGlow}" Margin="0,0,0,8"/>
                    <DataGrid Grid.Row="1" x:Name="GridRecipes" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionChanged="GridRecipes_SelectionChanged"
                              Background="Transparent" BorderBrush="{StaticResource KsBorder}" BorderThickness="1"
                              RowBackground="{StaticResource KsBgSurface}" AlternatingRowBackground="{StaticResource KsBgCard}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên Công Thức" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Mã SKU" Binding="{Binding ProductCode}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent"/>

            <!-- RIGHT DETAILS TABS -->
            <Border Grid.Column="2" Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                <TabControl Background="Transparent" BorderThickness="0">
                    <!-- TAB 1: OVERRIDES -->
                    <TabItem Header="⚙️ Tham Số Đè (Parameter Overrides)">
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Recipe Info Header -->
                            <Border Grid.Row="0" Background="{StaticResource KsBgSurface}" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Tên Công Thức:" FontSize="11" Foreground="{StaticResource KsTextDim}"/>
                                        <TextBox x:Name="TxtRecipeName" Background="{StaticResource KsBgCard}" Padding="6,4" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Mã Sản Phẩm (Product Code):" FontSize="11" Foreground="{StaticResource KsTextDim}"/>
                                        <TextBox x:Name="TxtProductCode" Background="{StaticResource KsBgCard}" Padding="6,4" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="4" x:Name="BtnSaveMeta" Content="Cập Nhật" Click="BtnSaveMeta_Click"
                                            VerticalAlignment="Bottom" Style="{StaticResource KsPrimaryButton}" Padding="10,5"/>
                                </Grid>
                            </Border>

                            <!-- Overrides Grid -->
                            <DataGrid Grid.Row="1" x:Name="GridOverrides" AutoGenerateColumns="False"
                                      Background="Transparent" BorderBrush="{StaticResource KsBorder}" BorderThickness="1"
                                      RowBackground="{StaticResource KsBgSurface}" AlternatingRowBackground="{StaticResource KsBgCard}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Node ID" Binding="{Binding NodeId}" Width="150" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Tên Tham Số" Binding="{Binding ParameterName}" Width="180" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Giá Trị Ghi Đè (Value)" Binding="{Binding Value}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- TAB 2: TOLERANCES -->
                    <TabItem Header="📏 Dung Sai Đo Lường (Tolerances)">
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="GIỚI HẠN DUNG SAI CHO CÁC PHÉP ĐO KIỂM TRA (MIN / TARGET / MAX)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource KsTextDim}" Margin="0,0,0,8"/>
                            <DataGrid Grid.Row="1" x:Name="GridTolerances" AutoGenerateColumns="False"
                                      Background="Transparent" BorderBrush="{StaticResource KsBorder}" BorderThickness="1"
                                      RowBackground="{StaticResource KsBgSurface}" AlternatingRowBackground="{StaticResource KsBgCard}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tên Phép Đo" Binding="{Binding Name}" Width="180"/>
                                    <DataGridTextColumn Header="Chuẩn (Target)" Binding="{Binding Nominal, StringFormat='F3'}" Width="100"/>
                                    <DataGridTextColumn Header="Giới Hạn Dưới (Min)" Binding="{Binding LowerLimit, StringFormat='F3'}" Width="120"/>
                                    <DataGridTextColumn Header="Giới Hạn Trên (Max)" Binding="{Binding UpperLimit, StringFormat='F3'}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- TAB 3: DIFF -->
                    <TabItem Header="⚖️ So Sánh Khác Biệt (Diff)">
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="So sánh với công thức: " VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource KsTextDim}"/>
                                <ComboBox Grid.Column="1" x:Name="CmbDiffTarget" Margin="8,0,8,0" Background="{StaticResource KsBgSurface}"/>
                                <Button Grid.Column="2" x:Name="BtnRunDiff" Content="So Sánh Đối Chiếu" Click="BtnRunDiff_Click"
                                        Style="{StaticResource KsSecondaryButton}" Padding="10,4"/>
                            </Grid>

                            <DataGrid Grid.Row="1" x:Name="GridDiff" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="Transparent" BorderBrush="{StaticResource KsBorder}" BorderThickness="1"
                                      RowBackground="{StaticResource KsBgSurface}" AlternatingRowBackground="{StaticResource KsBgCard}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Node ID" Binding="{Binding NodeId}" Width="120"/>
                                    <DataGridTextColumn Header="Tham Số" Binding="{Binding ParameterName}" Width="160"/>
                                    <DataGridTextColumn Header="Công Thức Hiện Tại" Binding="{Binding ValueA}" Width="*"/>
                                    <DataGridTextColumn Header="Công Thức Đối Chiếu" Binding="{Binding ValueB}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="0,1,0,0" Padding="12,0">
            <TextBlock x:Name="TxtStatus" Text="Sẵn sàng." FontSize="11" Foreground="{StaticResource KsTextDim}" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
