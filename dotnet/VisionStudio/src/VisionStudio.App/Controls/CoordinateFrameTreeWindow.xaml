<Window x:Class="VisionStudio.App.Controls.CoordinateFrameTreeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:frames="clr-namespace:VisionStudio.Matching.Frames;assembly=VisionStudio.Matching"
        mc:Ignorable="d"
        Title="Coordinate Frames &amp; Fixturing - Không Gian Toạ Độ &amp; Gá Đặt Bám Theo Phôi"
        Height="620" Width="920"
        MinHeight="450" MinWidth="700"
        Background="{StaticResource KsBgBase}" Foreground="{StaticResource KsText}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="50"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Footer Status Bar -->
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📐 " FontSize="18" VerticalAlignment="Center"/>
                    <TextBlock Text="CÂY KHÔNG GIAN TOẠ ĐỘ &amp; FIXTURING (SPACES)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource KsAccentGlow}" VerticalAlignment="Center"/>
                    <TextBlock Text=" | Nested Coordinate Frames &amp; Dynamic Tool ROI Anchoring" Foreground="{StaticResource KsTextDim}" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" x:Name="BtnRefreshTree" Content="🔄 Làm Mới Cây" Click="BtnRefreshTree_Click"
                        Style="{StaticResource KsSecondaryButton}" Padding="12,5"/>
            </Grid>
        </Border>

        <!-- MAIN SPLIT VIEW -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <!-- Left: Frame Hierarchy Tree -->
                <ColumnDefinition Width="380" MinWidth="300"/>
                <!-- Splitter -->
                <ColumnDefinition Width="6"/>
                <!-- Right: Frame Inspector & Fixturing Tester -->
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: TREE VIEW -->
            <Border Grid.Column="0" Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="CÂY PHÂN CẤP KHÔNG GIAN (SPACES TREE)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource KsAccentGlow}" Margin="0,0,0,8"/>

                    <TreeView Grid.Row="1" x:Name="TreeFrames" Background="Transparent" BorderThickness="0"
                              SelectedItemChanged="TreeFrames_SelectedItemChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type frames:FrameTreeNode}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="2,3">
                                    <TextBlock Text="📍 " FontSize="13"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{StaticResource KsText}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource KsTextDim}"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- RIGHT: FRAME INSPECTOR & FIXTURING CALCULATOR -->
            <Border Grid.Column="2" Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="CHI TIẾT KHÔNG GIAN ĐANG CHỌN" FontWeight="Bold" FontSize="12" Foreground="{StaticResource KsAccentGlow}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tên Frame:" Foreground="{StaticResource KsTextDim}" FontSize="11"/>
                            <TextBlock Grid.Column="1" x:Name="TxtSelectedName" Text="Root" FontWeight="Bold" Foreground="{StaticResource KsText}" FontSize="12"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Không gian cha:" Foreground="{StaticResource KsTextDim}" FontSize="11"/>
                            <TextBlock Grid.Column="1" x:Name="TxtSelectedParent" Text="(Không có - Là gốc)" Foreground="{StaticResource KsText}" FontSize="11"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Gốc (Origin X, Y):" Foreground="{StaticResource KsTextDim}" FontSize="11"/>
                            <TextBlock Grid.Column="1" x:Name="TxtSelectedOrigin" Text="(0.0, 0.0) px" Foreground="{StaticResource KsText}" FontSize="11"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Góc quay (Angle):" Foreground="{StaticResource KsTextDim}" FontSize="11"/>
                            <TextBlock Grid.Column="1" x:Name="TxtSelectedAngle" Text="0.0°" Foreground="{StaticResource KsText}" FontSize="11"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tỉ lệ (Scale):" Foreground="{StaticResource KsTextDim}" FontSize="11"/>
                            <TextBlock Grid.Column="1" x:Name="TxtSelectedScale" Text="1.00x" Foreground="{StaticResource KsText}" FontSize="11"/>
                        </Grid>

                        <!-- FIXTURING SIMULATOR -->
                        <Border Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="🛠️ THỬ NGHIỆM TỰ ĐỘNG GÁ ĐẶT (ROI FIXTURING)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource KsAccentGlow}" Margin="0,0,0,8"/>
                                <TextBlock Text="Nhập toạ độ ROI danh định trong phôi (Part Local Coordinates):" FontSize="10" Foreground="{StaticResource KsTextDim}" Margin="0,0,0,6"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Local X" FontSize="10" Foreground="{StaticResource KsTextDim}"/>
                                        <TextBox x:Name="TxtLocalX" Text="10" Style="{StaticResource KsTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Local Y" FontSize="10" Foreground="{StaticResource KsTextDim}"/>
                                        <TextBox x:Name="TxtLocalY" Text="20" Style="{StaticResource KsTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Local W" FontSize="10" Foreground="{StaticResource KsTextDim}"/>
                                        <TextBox x:Name="TxtLocalW" Text="40" Style="{StaticResource KsTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="Local H" FontSize="10" Foreground="{StaticResource KsTextDim}"/>
                                        <TextBox x:Name="TxtLocalH" Text="20" Style="{StaticResource KsTextBox}"/>
                                    </StackPanel>
                                </Grid>

                                <Button x:Name="BtnTestFixture" Content="⚡ Tính Toán Vùng Bám Theo Phôi (Fixture To Root Image)" Click="BtnTestFixture_Click"
                                        Style="{StaticResource KsPrimaryButton}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>

                                <TextBlock x:Name="TxtFixtureResult" Text="Kết quả: Hãy nhấn nút tính toán." FontSize="11" Foreground="{StaticResource KsTextDim}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- FOOTER STATUS BAR -->
        <Border Grid.Row="2" Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="0,1,0,0" Padding="14,0">
            <TextBlock x:Name="TxtStatus" Text="Sẵn sàng. Hệ thống hỗ trợ cây không gian phân cấp lồng nhau (Nested Spaces)." FontSize="11" Foreground="{StaticResource KsTextDim}"/>
        </Border>
    </Grid>
</Window>
