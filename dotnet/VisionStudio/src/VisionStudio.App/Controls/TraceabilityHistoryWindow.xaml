<Window x:Class="VisionStudio.App.Controls.TraceabilityHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Traceability History &amp; Cryptographic Audit - Lịch Sử Kiểm Tra &amp; Truy Xuất Nguồn Gốc"
        Height="820" Width="1340"
        MinHeight="600" MinWidth="950"
        Background="{StaticResource KsBgBase}" Foreground="{StaticResource KsText}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Controls Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Status Bar -->
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR & FILTER RIBBON -->
        <Border Grid.Row="0" Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Title & Main Action Buttons -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📜 " FontSize="20" VerticalAlignment="Center"/>
                        <TextBlock Text="TRUY XUẤT NGUỒN GỐC &amp; LỊCH SỬ SẢN XUẤT (TRACEABILITY STORE)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource KsAccentGlow}" VerticalAlignment="Center"/>
                        <Border x:Name="BrdIntegrityBadge" Background="#1B4D20" BorderBrush="#388E3C" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtIntegrityBadge" Text="🟢 CHUỖI BĂM TOÀN VẸN (TAMPER-FREE)" Foreground="#A0FFA0" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnVerifyChain" Content="🛡️ Kiểm Tra Toàn Vẹn" Click="BtnVerifyChain_Click"
                                Style="{StaticResource KsSecondaryButton}" Margin="0,0,8,0" Padding="12,5"/>
                        <Button x:Name="BtnExportCsv" Content="📥 Xuất Báo Cáo CSV" Click="BtnExportCsv_Click"
                                Style="{StaticResource KsSecondaryButton}" Margin="0,0,8,0" Padding="12,5"/>
                        <Button x:Name="BtnReplayBatch" Content="🔄 Chạy Replay Ngoại Tuyến" Click="BtnReplayBatch_Click"
                                Style="{StaticResource KsPrimaryButton}" Padding="14,5"/>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Search & Filter Controls -->
                <Border Grid.Row="1" Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Mã Lô (Lot Number):" FontSize="10" Foreground="{StaticResource KsTextDim}"/>
                            <TextBox x:Name="TxtFilterLot" Background="{StaticResource KsBgSurface}" Padding="4,2" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Số Seri (Serial Number):" FontSize="10" Foreground="{StaticResource KsTextDim}"/>
                            <TextBox x:Name="TxtFilterSerial" Background="{StaticResource KsBgSurface}" Padding="4,2" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Kết Quả (Verdict):" FontSize="10" Foreground="{StaticResource KsTextDim}"/>
                            <ComboBox x:Name="CmbFilterVerdict" SelectedIndex="0" Background="{StaticResource KsBgSurface}" Margin="0,2,0,0">
                                <ComboBoxItem Content="-- Tất Cả --"/>
                                <ComboBoxItem Content="Pass (Đạt)"/>
                                <ComboBoxItem Content="Fail (Lỗi)"/>
                                <ComboBoxItem Content="Warning (Cảnh báo)"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Công Thức (Recipe):" FontSize="10" Foreground="{StaticResource KsTextDim}"/>
                            <TextBox x:Name="TxtFilterRecipe" Background="{StaticResource KsBgSurface}" Padding="4,2" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="8" x:Name="BtnSearch" Content="🔍 Lọc Dữ Liệu" Click="BtnSearch_Click"
                                VerticalAlignment="Bottom" Style="{StaticResource KsPrimaryButton}" Padding="16,5"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN SPLIT VIEW -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <!-- Left: Records Table -->
                <ColumnDefinition Width="*" MinWidth="550"/>
                <ColumnDefinition Width="6"/>
                <!-- Right: Record Inspection Details & Preview -->
                <ColumnDefinition Width="460" MinWidth="340"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: RECORDS DATAGRID -->
            <Border Grid.Column="0" Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="DANH SÁCH BẢN GHI SẢN XUẤT (INSPECTION LOGS)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource KsAccentGlow}"/>
                        <TextBlock Grid.Column="1" x:Name="TxtRecordCount" Text="Hiển thị: 0 bản ghi" FontSize="11" Foreground="{StaticResource KsTextDim}"/>
                    </Grid>

                    <DataGrid Grid.Row="1" x:Name="GridRecords" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionChanged="GridRecords_SelectionChanged"
                              Background="Transparent" BorderBrush="{StaticResource KsBorder}" BorderThickness="1"
                              RowBackground="{StaticResource KsBgSurface}" AlternatingRowBackground="{StaticResource KsBgCard}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding SequenceNumber}" Width="45"/>
                            <DataGridTextColumn Header="Thời Gian" Binding="{Binding Timestamp, StringFormat='HH:mm:ss dd/MM'}" Width="110"/>
                            <DataGridTextColumn Header="Mã Lô" Binding="{Binding LotNumber}" Width="90"/>
                            <DataGridTextColumn Header="Số Seri" Binding="{Binding SerialNumber}" Width="95"/>
                            <DataGridTextColumn Header="Công Thức" Binding="{Binding RecipeName}" Width="120"/>
                            <DataGridTextColumn Header="Kết Quả" Binding="{Binding Verdict}" Width="75" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Độ Trễ" Binding="{Binding ExecutionTimeMs, StringFormat='{}{0:F1} ms'}" Width="70"/>
                            <DataGridTextColumn Header="Mã Băm (Hash)" Binding="{Binding RecordHash}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent"/>

            <!-- RIGHT: RECORD DETAILS & IMAGE PREVIEW -->
            <Border Grid.Column="2" Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="CHI TIẾT BẢN GHI KIỂM ĐỊNH" FontWeight="Bold" FontSize="12" Foreground="{StaticResource KsAccentGlow}" Margin="0,0,0,10"/>

                        <!-- Image Preview Box -->
                        <Border Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="6" Height="240" Margin="0,0,0,12" ClipToBounds="True">
                            <Grid>
                                <Image x:Name="ImgInspectionPreview" Stretch="Uniform"/>
                                <TextBlock x:Name="TxtNoImage" Text="Không có ảnh kiểm tra được lưu trữ" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource KsTextDim}" FontSize="12"/>
                            </Grid>
                        </Border>

                        <!-- Measurements List -->
                        <TextBlock Text="CÁC PHÉP ĐO (MEASUREMENTS)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource KsTextDim}" Margin="0,0,0,6"/>
                        <DataGrid x:Name="GridMeasurements" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="140"
                                  Background="Transparent" BorderBrush="{StaticResource KsBorder}" BorderThickness="1"
                                  RowBackground="{StaticResource KsBgSurface}" AlternatingRowBackground="{StaticResource KsBgCard}" Margin="0,0,0,12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Phép Đo (Feature)" Binding="{Binding Key}" Width="*"/>
                                <DataGridTextColumn Header="Giá Trị Đo" Binding="{Binding Value, StringFormat='F3'}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Cryptographic Proof Details -->
                        <TextBlock Text="BẰNG CHỨNG MẬT MÃ (TAMPER PROOF)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource KsTextDim}" Margin="0,0,0,6"/>
                        <Border Background="{StaticResource KsBgSurface}" CornerRadius="6" Padding="8">
                            <StackPanel>
                                <TextBlock Text="Mã Băm Tiền Nhiệm (Previous Hash):" FontSize="10" Foreground="{StaticResource KsTextDim}"/>
                                <TextBox x:Name="TxtPrevHash" IsReadOnly="True" Background="Transparent" Foreground="{StaticResource KsTextDim}" BorderThickness="0" FontFamily="Consolas" FontSize="10" Text="GENESIS"/>
                                <TextBlock Text="Mã Băm Bản Ghi (Record Hash):" FontSize="10" Foreground="{StaticResource KsTextDim}" Margin="0,4,0,0"/>
                                <TextBox x:Name="TxtCurrHash" IsReadOnly="True" Background="Transparent" Foreground="{StaticResource KsAccentGlow}" BorderThickness="0" FontFamily="Consolas" FontSize="10" Text="none"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="0,1,0,0" Padding="12,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Text="Sẵn sàng." FontSize="11" Foreground="{StaticResource KsTextDim}"/>
                <TextBlock Grid.Column="1" Text="VisionStudio Traceability &amp; Blockchain Compliance Engine" FontSize="11" Foreground="{StaticResource KsTextDim}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
