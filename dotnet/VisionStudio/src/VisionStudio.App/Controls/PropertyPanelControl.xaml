<UserControl x:Class="VisionStudio.App.Controls.PropertyPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:VisionStudio.App.Converters"
             xmlns:vm="clr-namespace:VisionStudio.App.ViewModels"
             xmlns:services="clr-namespace:VisionStudio.App.Services"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="340"
             Background="{StaticResource KsBgCard}">

    <UserControl.Resources>
        <conv:StatusToBrushConverter x:Key="StatusBrushConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <Grid>
        <!-- ========================================================================= -->
        <!-- STATE 1: NO SELECTION EMPTY PLACEHOLDER                                   -->
        <!-- ========================================================================= -->
        <Border Visibility="{Binding ShowEmptyPlaceholder, Converter={StaticResource BoolToVisConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <TextBlock Text="💡" FontSize="40" HorizontalAlignment="Center" Foreground="{StaticResource KsAccentGlow}" Margin="0,0,0,14"/>
                <TextBlock Text="CHỌN CÔNG CỤ ĐỂ XEM HƯỚNG DẪN"
                           FontWeight="Bold" FontSize="13" Foreground="{StaticResource KsTextMuted}" HorizontalAlignment="Center"/>
                <TextBlock Text="Bấm vào bất kỳ công cụ nào ở danh mục bên trái hoặc bấm vào một khối trên sơ đồ để xem thông số và hướng dẫn thuật toán kèm sơ đồ minh họa."
                           Foreground="{StaticResource KsTextDim}" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" LineHeight="17"/>
            </StackPanel>
        </Border>

        <!-- ========================================================================= -->
        <!-- STATE 2: TOOL CATALOG GUIDE PANEL (SHOWN ON TOOLBOX ITEM CLICK)          -->
        <!-- ========================================================================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding ShowCatalogGuide, Converter={StaticResource BoolToVisConverter}}">
            <StackPanel Margin="14">
                <!-- TOOL INFO HEADER & QUICK ADD -->
                <Border Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💡 " FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ActiveGuide.LocalizedDisplayName}" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource KsAccentGlow}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding ActiveGuide.LocalizedCategory}" FontWeight="SemiBold" FontSize="10" Foreground="{StaticResource KsTextMuted}"/>
                            </Border>
                        </Grid>

                        <Button Style="{StaticResource KsPrimaryButton}"
                                Command="{Binding AddNodeCommand}"
                                CommandParameter="{Binding SelectedToolItem}"
                                Content="➕ Thêm công cụ này vào sơ đồ (Add to Canvas)"
                                Margin="0,12,0,0" Padding="10,6" FontSize="11.5" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- VISUAL ALGORITHM FLOW DIAGRAM -->
                <Border Background="#090d16" BorderBrush="{StaticResource KsBorderAccent}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="🎨 Sơ đồ minh họa thuật toán:" FontWeight="Bold" Foreground="{StaticResource KsAccentGlow}" FontSize="10.5"/>
                            <Border HorizontalAlignment="Right" Background="#1e293b" CornerRadius="3" Padding="4,1">
                                <TextBlock Text="FLOW DIAGRAM" Foreground="#38bdf8" FontSize="9" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <TextBlock Text="{Binding ActiveGuide.IllustrationDiagram}" FontFamily="Consolas, Cascadia Code, Courier New"
                                       FontSize="10" Foreground="#38bdf8" LineHeight="14"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Principle -->
                <Border Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="📖 Nguyên lý &amp; Mục đích:" FontWeight="SemiBold" Foreground="{StaticResource KsTextMuted}" FontSize="10.5" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ActiveGuide.LocalizedPrinciple}" Foreground="{StaticResource KsText}" FontSize="11" TextWrapping="Wrap" LineHeight="16"/>
                    </StackPanel>
                </Border>

                <!-- Ports Guide -->
                <Border Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="🔌 Hướng dẫn nối cổng (Ports):" FontWeight="SemiBold" Foreground="{StaticResource KsTextMuted}" FontSize="10.5" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ActiveGuide.LocalizedPorts}" Foreground="{StaticResource KsAccentGlow}" FontSize="10.5" TextWrapping="Wrap" LineHeight="16"/>
                    </StackPanel>
                </Border>

                <!-- Parameters Tuning Guide -->
                <Border Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="⚙️ Cách tinh chỉnh tham số:" FontWeight="SemiBold" Foreground="{StaticResource KsTextMuted}" FontSize="10.5" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ActiveGuide.LocalizedParameters}" Foreground="{StaticResource KsText}" FontSize="10.5" TextWrapping="Wrap" LineHeight="16"/>
                    </StackPanel>
                </Border>

                <!-- Industrial Use Cases -->
                <Border Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="🏭 Ứng dụng công nghiệp thực tế:" FontWeight="SemiBold" Foreground="{StaticResource KsTextMuted}" FontSize="10.5" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ActiveGuide.LocalizedUseCases}" Foreground="{StaticResource KsSuccess}" FontSize="10.5" TextWrapping="Wrap" LineHeight="16"/>
                    </StackPanel>
                </Border>

                <!-- Quick Tips -->
                <Border Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorderAccent}" BorderThickness="1" CornerRadius="6" Padding="10">
                    <StackPanel>
                        <TextBlock Text="⚡ Mẹo thao tác nhanh:" FontWeight="SemiBold" Foreground="{StaticResource KsAccentGlow}" FontSize="10.5" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ActiveGuide.LocalizedTips}" Foreground="{StaticResource KsText}" FontSize="10.5" TextWrapping="Wrap" LineHeight="16"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ========================================================================= -->
        <!-- STATE 3: SELECTED CANVAS NODE PROPERTY & LIVE TUNING EDITOR               -->
        <!-- ========================================================================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      DataContext="{Binding SelectedNode}"
                      Visibility="{Binding DataContext.HasSelectedNode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisConverter}}">
            <StackPanel Margin="14">
                <!-- NODE INFO HEADER -->
                <Border Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource KsAccentGlow}"/>
                            <Border HorizontalAlignment="Right" Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="11"
                                           Foreground="{Binding Status, Converter={StaticResource StatusBrushConverter}}"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding Category, StringFormat='Category: {0}'}" Foreground="{StaticResource KsTextMuted}" FontSize="11" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource KsTextDim}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding ExecutionTimeMs, StringFormat='Last run: {0:F2} ms'}" Foreground="{StaticResource KsSuccess}" FontSize="11" Margin="0,4,0,0"/>
                        <Button Style="{StaticResource KsDangerButton}"
                                Command="{Binding DataContext.DeleteSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Content="🗑 Xóa công cụ này khỏi sơ đồ (Delete)"
                                Margin="0,8,0,0" Padding="8,4" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- INTERACTIVE ON-IMAGE PICKER QUICK ACTION PANEL -->
                <Border Background="#1a202c" BorderBrush="{StaticResource KsBorderAccent}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14"
                        Visibility="{Binding DataContext.SelectedNodeSupportsInteractiveSelection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🎯 " FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="CHỌN TRỰC TIẾP TRÊN ẢNH" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource KsAccentGlow}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Background="#0284c7" CornerRadius="3" Padding="5,1">
                                <TextBlock Text="INTERACTIVE" Foreground="White" FontSize="9" FontWeight="Bold"/>
                            </Border>
                        </Grid>

                        <TextBlock Text="Kéo thả trực tiếp bằng chuột trên cửa sổ ảnh để gán tọa độ và kích thước:"
                                   Foreground="{StaticResource KsTextDim}" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <!-- TEACH TARGET FOR OBJECT COUNTER / PATTERN -->
                        <Button Style="{StaticResource KsSuccessButton}"
                                Command="{Binding DataContext.TeachSelectedNodeTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Content="🎯 Dạy Mẫu Vật Thể (Teach Target)"
                                Visibility="{Binding DataContext.SelectedNodeSupportsTeach, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisConverter}}"
                                Margin="0,0,0,8" Padding="10,7" FontSize="11.5" FontWeight="Bold"
                                ToolTip="Khoanh vùng một vật thể mẫu (Táo, Gói hàng, Thùng, Chai...) trên ảnh để dạy mẫu: hệ thống sẽ chỉ nhận diện và đếm chính xác loại vật thể này, loại bỏ 100% đối tượng lạ và nhiễu!"/>

                        <!-- ROI Box button -->
                        <Button Style="{StaticResource KsPrimaryButton}"
                                Command="{Binding DataContext.SelectRoiOnImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Content="🔲 Kéo vùng chọn ROI (Box)"
                                Visibility="{Binding DataContext.SelectedNodeSupportsRoi, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisConverter}}"
                                Margin="0,0,0,6" Padding="8,5" FontSize="11"/>

                        <!-- Eraser Scan ROI button -->
                        <Button Style="{StaticResource KsWarningButton}"
                                Command="{Binding DataContext.EraseSelectedNodeScanRoiCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Content="🧽 Cục Tẩy (Tẩy Vùng Quét ROI)"
                                Visibility="{Binding DataContext.SelectedNodeSupportsRoi, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisConverter}}"
                                Margin="0,0,0,6" Padding="8,5" FontSize="11" FontWeight="SemiBold"
                                ToolTip="Xóa sạch vùng quét ROI lỡ khoanh mà không làm mất mẫu đã dạy hay vạch đếm!"/>

                        <!-- Line / Caliper / Tripwire Control Panel -->
                        <Border Visibility="{Binding DataContext.SelectedNodeSupportsLine, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisConverter}}"
                                Background="#1e2025" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="📏 VẠCH ĐẾM / ĐO KÍCH THƯỚC" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource KsAccentGlow}" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Button to activate direct drawing on image -->
                                <Button Style="{StaticResource KsPrimaryButton}"
                                        Command="{Binding DataContext.SelectLineOnImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Content="📏 Kéo Vạch Trên Cửa Sổ Ảnh"
                                        Margin="0,0,0,6" Padding="8,5" FontSize="11" FontWeight="SemiBold"
                                        ToolTip="Bật chế độ kéo vạch trên ảnh: Bạn có thể click chuột kéo đoạn thẳng mới, hoặc rê chuột vào 2 đầu mút / thân vạch có sẵn để di chuyển!"/>

                                <!-- Quick Direction Orientation -->
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="↔️ Vạch Ngang" Style="{StaticResource KsButton}" Padding="4,4" FontSize="10.5"
                                            Command="{Binding DataContext.SetLineHorizontalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            ToolTip="Đặt nhanh vạch đếm nằm ngang chắn toàn bộ băng tải"/>
                                    <Button Grid.Column="2" Content="↕️ Vạch Dọc" Style="{StaticResource KsButton}" Padding="4,4" FontSize="10.5"
                                            Command="{Binding DataContext.SetLineVerticalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            ToolTip="Đặt nhanh vạch đếm thẳng đứng từ trên xuống dưới"/>
                                </Grid>

                                <!-- Nudge Position Fine-tuning (10px steps) -->
                                <TextBlock Text="Dịch chuyển tinh chỉnh (Nudge 10px):" Foreground="{StaticResource KsTextDim}" FontSize="9.5" Margin="0,2,0,3"/>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="⬆️ Lên" Style="{StaticResource KsButton}" Padding="2,3" FontSize="10"
                                            Command="{Binding DataContext.NudgeLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="up" ToolTip="Dịch vạch lên trên 10px"/>
                                    <Button Grid.Column="2" Content="⬇️ Xuống" Style="{StaticResource KsButton}" Padding="2,3" FontSize="10"
                                            Command="{Binding DataContext.NudgeLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="down" ToolTip="Dịch vạch xuống dưới 10px"/>
                                    <Button Grid.Column="4" Content="⬅️ Trái" Style="{StaticResource KsButton}" Padding="2,3" FontSize="10"
                                            Command="{Binding DataContext.NudgeLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="left" ToolTip="Dịch vạch sang trái 10px"/>
                                    <Button Grid.Column="6" Content="➡️ Phải" Style="{StaticResource KsButton}" Padding="2,3" FontSize="10"
                                            Command="{Binding DataContext.NudgeLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="right" ToolTip="Dịch vạch sang phải 10px"/>
                                </Grid>

                                <!-- Extend / Shorten Length -->
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="➕ Kéo Dài Ra" Style="{StaticResource KsButton}" Padding="4,4" FontSize="10.5"
                                            Command="{Binding DataContext.NudgeLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="extend" ToolTip="Kéo dài vạch ra 2 phía thêm 30px"/>
                                    <Button Grid.Column="2" Content="➖ Thu Ngắn Lại" Style="{StaticResource KsButton}" Padding="4,4" FontSize="10.5"
                                            Command="{Binding DataContext.NudgeLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="shorten" ToolTip="Thu ngắn vạch bớt 30px"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Point Picker button -->
                        <Button Style="{StaticResource KsButton}"
                                Command="{Binding DataContext.SelectPointOnImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Content="📍 Chọn điểm tâm/tọa độ (Point)"
                                Visibility="{Binding DataContext.SelectedNodeSupportsPoint, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisConverter}}"
                                Margin="0,0,0,6" Padding="8,5" FontSize="11"/>

                        <!-- Polygon ROI button -->
                        <Button Style="{StaticResource KsButton}"
                                Command="{Binding DataContext.SelectPolygonOnImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Content="⬡ Đặt đa giác vùng chọn (Polygon)"
                                Visibility="{Binding DataContext.SelectedNodeSupportsPolygon, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisConverter}}"
                                Margin="0,0,0,6" Padding="8,5" FontSize="11"/>

                        <!-- Clear ROI button -->
                        <Button Style="{StaticResource KsDangerButton}"
                                Command="{Binding DataContext.ClearSelectedNodeRoiCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Content="🧹 Xóa Vùng Chọn ROI (Clear ROI)"
                                Visibility="{Binding DataContext.SelectedNodeSupportsClearRoi, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisConverter}}"
                                Margin="0,4,0,6" Padding="8,6" FontSize="11" FontWeight="SemiBold"
                                ToolTip="Xóa sạch các tọa độ vùng chọn ROI và hủy mẫu dạy"/>

                        <!-- Reset Teach button -->
                        <Button Style="{StaticResource KsButton}"
                                Command="{Binding DataContext.ResetSelectedNodeTeachCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Content="🔄 Hủy Mẫu Đã Dạy (Reset Teach)"
                                Visibility="{Binding DataContext.SelectedNodeSupportsTeach, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisConverter}}"
                                Margin="0,0,0,6" Padding="8,5" FontSize="11"
                                ToolTip="Hủy mẫu thùng đã học, quay về chế độ nhận diện tự động ban đầu"/>
                    </StackPanel>
                </Border>

                <!-- PARAMETERS LIST -->
                <TextBlock Text="{Binding [Props_ParametersSection], Source={x:Static services:LocalizationService.Instance}}"
                           FontWeight="Bold" Foreground="{StaticResource KsTextMuted}" FontSize="11" Margin="0,0,0,8"/>

                <ItemsControl ItemsSource="{Binding Parameters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ParameterEditorViewModel}">
                            <Border Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <!-- Parameter Name & Type -->
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource KsText}" FontSize="12"/>
                                        <TextBlock Text="{Binding ParameterType}" Foreground="{StaticResource KsTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- NUMERIC SLIDER & TEXTBOX (INTEGER / DOUBLE) -->
                                    <StackPanel Visibility="{Binding IsNumber, Converter={StaticResource BoolToVisConverter}}">
                                        <Grid Margin="0,0,0,4">
                                            <Slider Minimum="{Binding MinValue}" Maximum="{Binding MaxValue}"
                                                    Value="{Binding DoubleValue, UpdateSourceTrigger=PropertyChanged}"
                                                    SmallChange="{Binding Step}" LargeChange="{Binding Step}"
                                                    TickFrequency="{Binding Step}"
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding DoubleValue, StringFormat='{}{0:F2}', UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding MinValue, StringFormat='[{0} .. '}" Foreground="{StaticResource KsTextDim}" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding MaxValue, StringFormat='{}{0}]'}" Foreground="{StaticResource KsTextDim}" FontSize="10" VerticalAlignment="Center" Margin="44,0,0,0"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- BOOLEAN CHECKBOX -->
                                    <CheckBox Visibility="{Binding IsBoolean, Converter={StaticResource BoolToVisConverter}}"
                                              IsChecked="{Binding BoolValue, UpdateSourceTrigger=PropertyChanged}"
                                              Content="Enabled" Margin="0,4"/>

                                    <!-- ENUM COMBOBOX -->
                                    <ComboBox Visibility="{Binding IsEnum, Converter={StaticResource BoolToVisConverter}}"
                                              ItemsSource="{Binding EnumOptions}"
                                              SelectedItem="{Binding StringValue, UpdateSourceTrigger=PropertyChanged}"
                                              Margin="0,2"/>

                                    <!-- STRING TEXTBOX -->
                                    <TextBox Visibility="{Binding IsString, Converter={StaticResource BoolToVisConverter}}"
                                             Text="{Binding StringValue, UpdateSourceTrigger=PropertyChanged}"/>

                                    <!-- FILE PATH BROWSER -->
                                    <Grid Visibility="{Binding IsFilePath, Converter={StaticResource BoolToVisConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding StringValue, UpdateSourceTrigger=LostFocus}"/>
                                        <Button Grid.Column="1" Content="..." Command="{Binding BrowseFileCommand}"
                                                Style="{StaticResource KsButton}" Margin="4,0,0,0" Padding="8,4"/>
                                    </Grid>

                                    <!-- Description Tooltip/Text -->
                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource KsTextDim}" FontSize="10.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- OUTPUT RESULTS SECTION -->
                <TextBlock Text="{Binding [Props_OutputsSection], Source={x:Static services:LocalizationService.Instance}}"
                           FontWeight="Bold" Foreground="{StaticResource KsTextMuted}" FontSize="11" Margin="0,10,0,8"/>

                <Border Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                    <ItemsControl ItemsSource="{Binding OutputValuesSummary}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Key}" Foreground="{StaticResource KsTextMuted}" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{StaticResource KsAccentGlow}" FontWeight="SemiBold" FontFamily="Consolas" FontSize="11"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- DETAILED TOOL INSTRUCTIONS & INDUSTRIAL GUIDE EXPANDER -->
                <Expander IsExpanded="True" Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" Padding="8">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💡 " FontSize="12"/>
                            <TextBlock Text="{Binding [Props_GuideSection], Source={x:Static services:LocalizationService.Instance}}"
                                       FontWeight="Bold" Foreground="{StaticResource KsAccentGlow}" FontSize="11"/>
                        </StackPanel>
                    </Expander.Header>

                    <StackPanel Margin="4,10,4,4">
                        <!-- Full Tool Title -->
                        <TextBlock Text="{Binding GuideTitle}" FontWeight="SemiBold" Foreground="{StaticResource KsText}" FontSize="12.5" Margin="0,0,0,6"/>

                        <!-- VISUAL ALGORITHM FLOW DIAGRAM -->
                        <Border Background="#090d16" BorderBrush="{StaticResource KsBorderAccent}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="🎨 Sơ đồ minh họa thuật toán:" FontWeight="Bold" Foreground="{StaticResource KsAccentGlow}" FontSize="10.5"/>
                                    <Border HorizontalAlignment="Right" Background="#1e293b" CornerRadius="3" Padding="4,1">
                                        <TextBlock Text="FLOW DIAGRAM" Foreground="#38bdf8" FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <TextBlock Text="{Binding IllustrationDiagram}" FontFamily="Consolas, Cascadia Code, Courier New"
                                               FontSize="10" Foreground="#38bdf8" LineHeight="14"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Principle / Explanation -->
                        <Border Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="📖 Nguyên lý &amp; Mục đích:" FontWeight="SemiBold" Foreground="{StaticResource KsTextMuted}" FontSize="10.5" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding GuidePrinciple}" Foreground="{StaticResource KsText}" FontSize="11" TextWrapping="Wrap" LineHeight="16"/>
                            </StackPanel>
                        </Border>

                        <!-- Ports Wiring Guide -->
                        <Border Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="🔌 Hướng dẫn nối cổng (Ports):" FontWeight="SemiBold" Foreground="{StaticResource KsTextMuted}" FontSize="10.5" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding GuidePorts}" Foreground="{StaticResource KsAccentGlow}" FontSize="10.5" TextWrapping="Wrap" LineHeight="16"/>
                            </StackPanel>
                        </Border>

                        <!-- Parameters Tuning Guide -->
                        <Border Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="⚙️ Cách tinh chỉnh tham số:" FontWeight="SemiBold" Foreground="{StaticResource KsTextMuted}" FontSize="10.5" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding GuideParameters}" Foreground="{StaticResource KsText}" FontSize="10.5" TextWrapping="Wrap" LineHeight="16"/>
                            </StackPanel>
                        </Border>

                        <!-- Industrial Use Cases -->
                        <Border Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="🏭 Ứng dụng công nghiệp thực tế:" FontWeight="SemiBold" Foreground="{StaticResource KsTextMuted}" FontSize="10.5" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding GuideUseCases}" Foreground="{StaticResource KsSuccess}" FontSize="10.5" TextWrapping="Wrap" LineHeight="16"/>
                            </StackPanel>
                        </Border>

                        <!-- Quick Tips -->
                        <Border Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorderAccent}" BorderThickness="1" CornerRadius="6" Padding="10">
                            <StackPanel>
                                <TextBlock Text="⚡ Mẹo thao tác nhanh:" FontWeight="SemiBold" Foreground="{StaticResource KsAccentGlow}" FontSize="10.5" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding GuideTips}" Foreground="{StaticResource KsText}" FontSize="10.5" TextWrapping="Wrap" LineHeight="16"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
