<Window x:Class="VisionStudio.App.Controls.StateMachineEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚙️ Trình thiết kế &amp; Mô phỏng Máy trạng thái (Industrial State Machine Editor)"
        Height="780" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#181824" Foreground="#E0E0E0"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="KsBgSurface" Color="#222232"/>
        <SolidColorBrush x:Key="KsBgCard" Color="#2B2B3E"/>
        <SolidColorBrush x:Key="KsBorder" Color="#383850"/>
        <SolidColorBrush x:Key="KsAccent" Color="#4A90E2"/>
        <SolidColorBrush x:Key="KsAccentGlow" Color="#64B5F6"/>
        <SolidColorBrush x:Key="KsSuccess" Color="#2ECC71"/>
        <SolidColorBrush x:Key="KsWarning" Color="#F39C12"/>
        <SolidColorBrush x:Key="KsDanger" Color="#E74C3C"/>
        <SolidColorBrush x:Key="KsTextMuted" Color="#A0A0B8"/>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource KsBgCard}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource KsBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3B3B54"/>
                    <Setter Property="BorderBrush" Value="{StaticResource KsAccent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#2980B9"/>
            <Setter Property="BorderBrush" Value="{StaticResource KsAccent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3498DB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚙️ State Machine:" FontWeight="Bold" FontSize="16" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtMachineName" Text="InspectionSequence" Width="200" Background="#181824" Foreground="White" BorderBrush="{StaticResource KsBorder}" Padding="6,4" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    
                    <Button Content="📄 Tạo mới" Click="BtnNew_Click" Style="{StaticResource ActionButton}" Margin="0,0,6,0"/>
                    <Button Content="📂 Mở .vsstate" Click="BtnOpen_Click" Style="{StaticResource ActionButton}" Margin="0,0,6,0"/>
                    <Button Content="💾 Lưu .vsstate" Click="BtnSave_Click" Style="{StaticResource ActionButton}" Margin="0,0,14,0"/>

                    <Border Background="#1C2833" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Trạng thái hiện tại: " Foreground="{StaticResource KsTextMuted}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtActiveStateBadge" Text="Idle" FontWeight="Bold" Foreground="#64B5F6" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Live Simulation Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Sự kiện:" VerticalAlignment="Center" Foreground="{StaticResource KsTextMuted}" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbEvent" Width="140" Background="#181824" Foreground="White" BorderBrush="{StaticResource KsBorder}" Margin="0,0,6,0" IsEditable="True"/>
                    <Button Content="⚡ Kích hoạt" Click="BtnTriggerEvent_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0"/>
                    <Button Content="🔄 Reset" Click="BtnReset_Click" Style="{StaticResource ActionButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace (Left: States & Transitions, Center: Visual Diagram Canvas, Right: Inspector & Mermaid) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: States & Transitions List -->
            <Border Grid.Column="0" Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="📍 Danh sách Trạng thái (States)" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        <Button Content="+ Thêm" Click="BtnAddState_Click" Style="{StaticResource ActionButton}" Padding="8,3" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <ListBox x:Name="LstStates" Grid.Row="1" Background="#181824" BorderBrush="{StaticResource KsBorder}" Foreground="White" SelectionChanged="LstStates_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="●" Foreground="#64B5F6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Id}" Foreground="{StaticResource KsTextMuted}" FontSize="11" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <DockPanel Grid.Row="2" Margin="0,10,0,6">
                        <TextBlock Text="🔀 Bước chuyển (Transitions)" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        <Button Content="+ Thêm" Click="BtnAddTransition_Click" Style="{StaticResource ActionButton}" Padding="8,3" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <ListBox x:Name="LstTransitions" Grid.Row="3" Background="#181824" BorderBrush="{StaticResource KsBorder}" Foreground="White" SelectionChanged="LstTransitions_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding FromStateId}" Foreground="#64B5F6" FontWeight="SemiBold"/>
                                        <TextBlock Text=" ➔ " Foreground="{StaticResource KsTextMuted}"/>
                                        <TextBlock Text="{Binding ToStateId}" Foreground="#2ECC71" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding TriggerEvent, StringFormat='Sự kiện: {0}'}" Foreground="{StaticResource KsTextMuted}" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Center: Interactive Visual State Diagram Canvas -->
            <Border Grid.Column="1" Background="#151520" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" ClipToBounds="True" Margin="0,0,10,0">
                <Grid>
                    <!-- Background Grid Pattern -->
                    <Canvas x:Name="CanvasDiagram" Background="#151520" MouseLeftButtonDown="CanvasDiagram_MouseLeftButtonDown" MouseMove="CanvasDiagram_MouseMove" MouseLeftButtonUp="CanvasDiagram_MouseLeftButtonUp">
                        <!-- Transition lines and State nodes will be rendered dynamically -->
                    </Canvas>

                    <!-- Hint Overlay -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Background="#80000000" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="Kéo các khối để sắp xếp sơ đồ • Nhấp chọn để xem thuộc tính" Foreground="{StaticResource KsTextMuted}" FontSize="11"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Panel: Inspector, Mermaid Diagram & Simulation Log -->
            <Border Grid.Column="2" Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="10">
                <TabControl Background="Transparent" BorderThickness="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Foreground" Value="{StaticResource KsTextMuted}"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="10,6"/>
                        </Style>
                    </TabControl.Resources>

                    <!-- Tab 1: Inspector -->
                    <TabItem Header="⚙️ Thuộc tính">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Cấu hình State đang chọn:" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                                
                                <TextBlock Text="Mã định danh (Id):" Foreground="{StaticResource KsTextMuted}" Margin="0,4,0,2"/>
                                <TextBox x:Name="TxtSelectedStateId" Background="#181824" Foreground="White" BorderBrush="{StaticResource KsBorder}" Padding="6,4" TextChanged="TxtSelectedStateId_TextChanged"/>

                                <TextBlock Text="Tên trạng thái:" Foreground="{StaticResource KsTextMuted}" Margin="0,6,0,2"/>
                                <TextBox x:Name="TxtSelectedStateName" Background="#181824" Foreground="White" BorderBrush="{StaticResource KsBorder}" Padding="6,4" TextChanged="TxtSelectedStateName_TextChanged"/>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,2">
                                    <CheckBox x:Name="ChkIsInitial" Content="Khởi đầu (Initial)" Foreground="White" Margin="0,0,12,0" Checked="ChkStateFlag_Changed" Unchecked="ChkStateFlag_Changed"/>
                                    <CheckBox x:Name="ChkIsFinal" Content="Kết thúc (Final)" Foreground="White" Margin="0,0,12,0" Checked="ChkStateFlag_Changed" Unchecked="ChkStateFlag_Changed"/>
                                    <CheckBox x:Name="ChkIsError" Content="Lỗi (Error)" Foreground="White" Checked="ChkStateFlag_Changed" Unchecked="ChkStateFlag_Changed"/>
                                </StackPanel>

                                <TextBlock Text="Timeout (ms):" Foreground="{StaticResource KsTextMuted}" Margin="0,8,0,2"/>
                                <TextBox x:Name="TxtTimeoutMs" Background="#181824" Foreground="White" BorderBrush="{StaticResource KsBorder}" Padding="6,4" TextChanged="TxtTimeoutMs_TextChanged"/>

                                <Button Content="Xóa State này" Click="BtnDeleteState_Click" Style="{StaticResource ActionButton}" Foreground="{StaticResource KsDanger}" Margin="0,14,0,0"/>

                                <Separator Background="{StaticResource KsBorder}" Margin="0,14,0,14"/>

                                <TextBlock Text="Cấu hình Transition đang chọn:" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                                <TextBlock Text="Từ State (From):" Foreground="{StaticResource KsTextMuted}" Margin="0,4,0,2"/>
                                <TextBox x:Name="TxtTransFrom" Background="#181824" Foreground="White" BorderBrush="{StaticResource KsBorder}" Padding="6,4" TextChanged="TxtTransFrom_TextChanged"/>

                                <TextBlock Text="Đến State (To):" Foreground="{StaticResource KsTextMuted}" Margin="0,6,0,2"/>
                                <TextBox x:Name="TxtTransTo" Background="#181824" Foreground="White" BorderBrush="{StaticResource KsBorder}" Padding="6,4" TextChanged="TxtTransTo_TextChanged"/>

                                <TextBlock Text="Sự kiện kích hoạt (Event):" Foreground="{StaticResource KsTextMuted}" Margin="0,6,0,2"/>
                                <TextBox x:Name="TxtTransEvent" Background="#181824" Foreground="White" BorderBrush="{StaticResource KsBorder}" Padding="6,4" TextChanged="TxtTransEvent_TextChanged"/>

                                <TextBlock Text="Điều kiện (Expression):" Foreground="{StaticResource KsTextMuted}" Margin="0,6,0,2"/>
                                <TextBox x:Name="TxtTransCondition" Background="#181824" Foreground="White" BorderBrush="{StaticResource KsBorder}" Padding="6,4" TextChanged="TxtTransCondition_TextChanged"/>

                                <Button Content="Xóa Transition này" Click="BtnDeleteTransition_Click" Style="{StaticResource ActionButton}" Foreground="{StaticResource KsDanger}" Margin="0,14,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 2: Mermaid Diagram -->
                    <TabItem Header="📊 Mermaid">
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="TxtMermaid" Grid.Row="0" Background="#181824" Foreground="#85E89D" FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderBrush="{StaticResource KsBorder}" Padding="8"/>
                            <Button Grid.Row="1" Content="📋 Sao chép Mermaid" Click="BtnCopyMermaid_Click" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0"/>
                        </Grid>
                    </TabItem>

                    <!-- Tab 3: Simulation Log -->
                    <TabItem Header="📜 Nhật ký">
                        <Grid Margin="0,10,0,0">
                            <TextBox x:Name="TxtSimLog" Background="#181824" Foreground="#D1D5DB" FontFamily="Consolas" FontSize="11" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderBrush="{StaticResource KsBorder}" Padding="8"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock Text="Industrial State Machine Engine &amp; Mermaid Diagram Visualizer • VisionStudio" Foreground="{StaticResource KsTextMuted}" FontSize="12" VerticalAlignment="Center"/>
                <Button Content="Đóng" Click="BtnClose_Click" Style="{StaticResource ActionButton}" HorizontalAlignment="Right" Padding="16,6"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
