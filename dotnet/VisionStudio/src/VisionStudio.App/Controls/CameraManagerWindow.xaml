<Window x:Class="VisionStudio.App.Controls.CameraManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:services="clr-namespace:VisionStudio.App.Services"
        xmlns:converters="clr-namespace:VisionStudio.App.Converters"
        mc:Ignorable="d"
        Title="VisionStudio - Trung Tâm Quản Lý Camera &amp; Bộ Giả Lập Đa Nguồn"
        Height="740" Width="1120"
        MinHeight="550" MinWidth="850"
        Background="{StaticResource KsBgBase}" Foreground="{StaticResource KsText}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="50"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Footer Status Bar -->
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📷 " FontSize="18" VerticalAlignment="Center"/>
                    <TextBlock Text="QUẢN LÝ THU NHẬN ẢNH CAMERA &amp; GIẢ LẬP" FontWeight="Bold" FontSize="14" Foreground="{StaticResource KsAccentGlow}" VerticalAlignment="Center"/>
                    <TextBlock Text=" | GigE / USB / Folder / Synthetic Hub" Foreground="{StaticResource KsTextDim}" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                <!-- Quick Snapshot to Pipeline Action -->
                <Button Grid.Column="1" Style="{StaticResource KsSuccessButton}"
                        Command="{Binding SendSnapshotToPipelineCommand}"
                        Content="📥 Chuyển khung hình vào Pipeline"/>
            </Grid>
        </Border>

        <!-- MAIN SPLIT VIEW -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <!-- Left: Controls & Parameters -->
                <ColumnDefinition Width="340" MinWidth="280"/>
                <!-- Splitter -->
                <ColumnDefinition Width="6"/>
                <!-- Right: Live Video Stream & HUD -->
                <ColumnDefinition Width="*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT CONTROL PANEL -->
            <Border Grid.Column="0" Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Camera Selector -->
                        <TextBlock Text="THIẾT BỊ CAMERA ĐANG CHỌN" FontWeight="Bold" FontSize="11" Foreground="{StaticResource KsTextMuted}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}"
                                  DisplayMemberPath="Name" Margin="0,0,0,10"/>

                        <!-- Connection & Discovery Buttons -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource KsPrimaryButton}"
                                    Command="{Binding ConnectCommand}" Content="🔌 Kết nối"
                                    IsEnabled="{Binding IsConnected, Converter={x:Static converters:InverseBooleanConverter.Instance}}"/>
                            <Button Grid.Column="2" Style="{StaticResource KsButton}"
                                    Command="{Binding DisconnectCommand}" Content="❌ Ngắt kết nối"
                                    IsEnabled="{Binding IsConnected}"/>
                        </Grid>

                        <Button Style="{StaticResource KsButton}" Command="{Binding DiscoverCamerasAsyncCommand}"
                                Content="🔍 Quét tìm thiết bị mới" Margin="0,0,0,12"/>

                        <!-- Acquisition Modes -->
                        <Border Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="ĐIỀU KHIỂN THU NHẬN KHUNG HÌNH" FontWeight="Bold" FontSize="11" Foreground="{StaticResource KsAccentGlow}" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource KsPrimaryButton}"
                                            Command="{Binding StartGrabbingCommand}" Content="▶ Chạy Live Feed"/>
                                    <Button Grid.Column="2" Style="{StaticResource KsButton}"
                                            Command="{Binding StopGrabbingCommand}" Content="⏸ Dừng Live"/>
                                </Grid>
                                <Button Style="{StaticResource KsButton}" Command="{Binding SnapFrameCommand}"
                                        Content="📸 Chụp 1 ảnh (Snap / Trigger)"/>
                            </StackPanel>
                        </Border>

                        <!-- Hardware / Simulation Parameters -->
                        <Border Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="THAM SỐ QUANG HỌC &amp; CẢM BIẾN" FontWeight="Bold" FontSize="11" Foreground="{StaticResource KsAccentGlow}" Margin="0,0,0,12"/>

                                <!-- Exposure Time -->
                                <StackPanel Margin="0,0,0,10">
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Thời gian phơi sáng (Exposure):" FontSize="11" Foreground="{StaticResource KsTextMuted}"/>
                                        <TextBlock Text="{Binding ExposureTime, StringFormat='{}{0:F0} µs'}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="{StaticResource KsAccentGlow}"/>
                                    </Grid>
                                    <Slider Minimum="1000" Maximum="100000" Value="{Binding ExposureTime}" SmallChange="1000" LargeChange="5000"/>
                                </StackPanel>

                                <!-- Sensor Gain -->
                                <StackPanel Margin="0,0,0,10">
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Độ khuếch đại (Gain):" FontSize="11" Foreground="{StaticResource KsTextMuted}"/>
                                        <TextBlock Text="{Binding Gain, StringFormat='{}{0:F1} dB'}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="{StaticResource KsAccentGlow}"/>
                                    </Grid>
                                    <Slider Minimum="0" Maximum="24" Value="{Binding Gain}" SmallChange="0.5" LargeChange="2"/>
                                </StackPanel>

                                <!-- Frame Rate -->
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Tốc độ khung hình mục tiêu (FPS):" FontSize="11" Foreground="{StaticResource KsTextMuted}"/>
                                        <TextBlock Text="{Binding FrameRate, StringFormat='{}{0:F0} FPS'}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="{StaticResource KsAccentGlow}"/>
                                    </Grid>
                                    <Slider Minimum="1" Maximum="60" Value="{Binding FrameRate}" SmallChange="1" LargeChange="5"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Synthetic & Simulator Features -->
                        <Border Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="ĐẶC TÍNH NÂNG CAO &amp; TIÊM LỖI" FontWeight="Bold" FontSize="11" Foreground="{StaticResource KsAccentGlow}" Margin="0,0,0,10"/>

                                <TextBlock Text="Mẫu phôi giả lập:" FontSize="11" Foreground="{StaticResource KsTextMuted}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding AvailablePatterns}" SelectedItem="{Binding SelectedPattern}"
                                          Margin="0,0,0,10"/>

                                <CheckBox IsChecked="{Binding DefectInjection}" Content="Bật tiêm lỗi khuyết tật phôi"
                                          Foreground="{StaticResource KsText}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,10"/>

                                <TextBlock Text="Loại lỗi tiêm vào:" FontSize="11" Foreground="{StaticResource KsTextMuted}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding AvailableDefectTypes}" SelectedItem="{Binding DefectType}"
                                          Margin="0,0,0,10"/>

                                <!-- Folder path for File Simulator -->
                                <TextBlock Text="Thư mục ảnh (cho File Simulator):" FontSize="11" Foreground="{StaticResource KsTextMuted}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- RIGHT VIDEO VIEWPORT -->
            <Border Grid.Column="2" Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                <Grid>
                    <!-- Video Stream Image -->
                    <Image Source="{Binding PreviewImage}" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                    <!-- Fallback Placeholder when no image -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="📷" FontSize="48" HorizontalAlignment="Center" Foreground="{StaticResource KsTextDim}"/>
                        <TextBlock Text="Bấm 'Chạy Live Feed' hoặc 'Chụp 1 ảnh' để xem luồng camera"
                                   Foreground="{StaticResource KsTextMuted}" FontSize="13" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Real-Time Telemetry HUD Overlays -->
                    <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="14"
                            Background="#e618181b" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="6" Padding="12,6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.4" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <!-- FPS -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                <TextBlock Text="FPS: " Foreground="{StaticResource KsTextMuted}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CurrentFps, StringFormat='{}{0:F1}'}" Foreground="{StaticResource KsSuccess}" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                            <!-- Frame ID -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                <TextBlock Text="Frames: " Foreground="{StaticResource KsTextMuted}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding FrameCount, StringFormat='{}{0:N0}'}" Foreground="{StaticResource KsAccentGlow}" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                            <!-- Latency -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                <TextBlock Text="Grab Latency: " Foreground="{StaticResource KsTextMuted}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding LastLatencyMs, StringFormat='{}{0:F1} ms'}" Foreground="{StaticResource KsWarning}" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                            <!-- Dropped -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Dropped: " Foreground="{StaticResource KsTextMuted}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DroppedFrames}" Foreground="{StaticResource KsDanger}" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER STATUS BAR -->
        <Border Grid.Row="2" Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource KsTextMuted}" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Text="Industrial Vision Camera Manager | GigE / USB3 / GenICam / File / Synthetic"
                           Foreground="{StaticResource KsTextDim}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
