<Window x:Class="VisionStudio.App.Controls.AutoTuneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🎛️ Bộ Tối ưu Hóa Tự động Tham số (Auto-Tune Engine)"
        Height="700" Width="980"
        WindowStartupLocation="CenterScreen"
        Background="#181824" Foreground="#E0E0E0"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="KsBgSurface" Color="#222232"/>
        <SolidColorBrush x:Key="KsBgCard" Color="#2B2B3E"/>
        <SolidColorBrush x:Key="KsBorder" Color="#383850"/>
        <SolidColorBrush x:Key="KsAccent" Color="#4A90E2"/>
        <SolidColorBrush x:Key="KsAccentGlow" Color="#64B5F6"/>
        <SolidColorBrush x:Key="KsSuccess" Color="#2ECC71"/>
        <SolidColorBrush x:Key="KsDanger" Color="#E74C3C"/>
        <SolidColorBrush x:Key="KsTextMuted" Color="#A0A0B8"/>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource KsBgCard}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource KsBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3B3B54"/>
                    <Setter Property="BorderBrush" Value="{StaticResource KsAccent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="🎛️ Bộ Tối ưu Hóa Tự động Tham số (Discriminative Auto-Tune)" FontWeight="Bold" FontSize="16" Foreground="{StaticResource KsAccentGlow}"/>
                <TextBlock Text="Học từ tập ảnh mẫu Good/Bad, tự động quét không gian tham số nhằm tối đa hóa khoảng cách phân biệt và đạt F1-Score 100%" FontSize="12" Foreground="{StaticResource KsTextMuted}" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Configuration Side -->
            <Border Grid.Column="0" Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="CẤU HÌNH AUTO-TUNE" FontWeight="Bold" FontSize="11" Foreground="{StaticResource KsTextMuted}" Margin="0,0,0,10"/>

                        <!-- Target Node -->
                        <TextBlock Text="Khối công cụ mục tiêu:" FontSize="12" Foreground="{StaticResource KsTextMuted}"/>
                        <ComboBox x:Name="CmbTargetNodes" Background="{StaticResource KsBgCard}" Foreground="White" Margin="0,4,0,12" SelectionChanged="OnTargetNodeChanged"/>

                        <!-- Tunable Parameter -->
                        <TextBlock Text="Tham số cần tối ưu:" FontSize="12" Foreground="{StaticResource KsTextMuted}"/>
                        <ComboBox x:Name="CmbTargetParam" Background="{StaticResource KsBgCard}" Foreground="White" Margin="0,4,0,12" SelectionChanged="OnTargetParamChanged"/>

                        <!-- Search bounds -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Min:" FontSize="11" Foreground="{StaticResource KsTextMuted}"/>
                                <TextBox x:Name="TxtMin" Text="0" Background="{StaticResource KsBgCard}" Foreground="White" BorderBrush="{StaticResource KsBorder}" Margin="0,3,0,0" Padding="6,4"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="2,0,2,0">
                                <TextBlock Text="Max:" FontSize="11" Foreground="{StaticResource KsTextMuted}"/>
                                <TextBox x:Name="TxtMax" Text="255" Background="{StaticResource KsBgCard}" Foreground="White" BorderBrush="{StaticResource KsBorder}" Margin="0,3,0,0" Padding="6,4"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                <TextBlock Text="Bước (Step):" FontSize="11" Foreground="{StaticResource KsTextMuted}"/>
                                <TextBox x:Name="TxtStep" Text="10" Background="{StaticResource KsBgCard}" Foreground="White" BorderBrush="{StaticResource KsBorder}" Margin="0,3,0,0" Padding="6,4"/>
                            </StackPanel>
                        </Grid>

                        <!-- Evaluation Metric -->
                        <TextBlock Text="Cổng thước đo đánh giá:" FontSize="12" Foreground="{StaticResource KsTextMuted}"/>
                        <TextBox x:Name="TxtMetricPort" Text="Score" Background="{StaticResource KsBgCard}" Foreground="White" BorderBrush="{StaticResource KsBorder}" Margin="0,4,0,12" Padding="6,4"/>

                        <Border Height="1" Background="{StaticResource KsBorder}" Margin="0,4,0,12"/>

                        <!-- Training Sample Folders -->
                        <TextBlock Text="TẬP ẢNH MẪU ĐÁNH GIÁ (SAMPLES)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource KsTextMuted}" Margin="0,0,0,8"/>

                        <!-- Good Folder -->
                        <TextBlock Text="Thư mục ảnh Đạt (Good / OK):" FontSize="12" Foreground="{StaticResource KsSuccess}"/>
                        <Grid Margin="0,4,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtGoodPath" Background="{StaticResource KsBgCard}" Foreground="White" BorderBrush="{StaticResource KsBorder}" Padding="6,4"/>
                            <Button Grid.Column="1" Style="{StaticResource ActionButton}" Content="..." Click="OnBrowseGoodClick" Margin="4,0,0,0"/>
                        </Grid>

                        <!-- Bad Folder -->
                        <TextBlock Text="Thư mục ảnh Lỗi (Bad / NG):" FontSize="12" Foreground="{StaticResource KsDanger}"/>
                        <Grid Margin="0,4,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtBadPath" Background="{StaticResource KsBgCard}" Foreground="White" BorderBrush="{StaticResource KsBorder}" Padding="6,4"/>
                            <Button Grid.Column="1" Style="{StaticResource ActionButton}" Content="..." Click="OnBrowseBadClick" Margin="4,0,0,0"/>
                        </Grid>

                        <Button x:Name="BtnRunAutoTune" Style="{StaticResource ActionButton}" Background="{StaticResource KsAccent}" Content="🚀 Bắt đầu Auto-Tune" Click="OnRunAutoTuneClick" Padding="14,10" FontWeight="Bold"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Results & Report Side -->
            <Border Grid.Column="1" Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="KẾT QUẢ VÀ BÁO CÁO PHÂN TÁCH" FontWeight="Bold" FontSize="11" Foreground="{StaticResource KsTextMuted}" Margin="0,0,0,10"/>

                    <!-- Metric Badges -->
                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="ĐỘ CHÍNH XÁC" FontSize="10" Foreground="{StaticResource KsTextMuted}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtAccuracy" Text="--%" FontWeight="Bold" FontSize="18" Foreground="{StaticResource KsSuccess}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="3,0,3,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="F1-SCORE" FontSize="10" Foreground="{StaticResource KsTextMuted}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtF1" Text="--%" FontWeight="Bold" FontSize="18" Foreground="{StaticResource KsAccentGlow}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="3,0,3,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="KHOẢNG TÁCH BIỆT" FontSize="10" Foreground="{StaticResource KsTextMuted}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtMargin" Text="--" FontWeight="Bold" FontSize="18" Foreground="#FFD54F" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="NGƯỠNG ĐỀ XUẤT" FontSize="10" Foreground="{StaticResource KsTextMuted}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtThreshold" Text="--" FontWeight="Bold" FontSize="18" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Full text report -->
                    <TextBox Grid.Row="2" x:Name="TxtReport" IsReadOnly="True" Background="{StaticResource KsBgCard}" Foreground="#C8C8DC" BorderBrush="{StaticResource KsBorder}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10" Text="Chưa có báo cáo. Hãy chọn khối công cụ và tập ảnh mẫu rồi bấm 'Bắt đầu Auto-Tune'."/>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Actions -->
        <Border Grid.Row="2" Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
            <Grid>
                <TextBlock x:Name="TxtStatus" Text="Sẵn sàng." VerticalAlignment="Center" Foreground="{StaticResource KsTextMuted}" FontSize="12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnApplyToNode" Style="{StaticResource ActionButton}" Background="{StaticResource KsSuccess}" Content="✅ Áp dụng tham số vào Node" Click="OnApplyClick" Margin="0,0,8,0" IsEnabled="False"/>
                    <Button Style="{StaticResource ActionButton}" Content="Đóng" Click="OnCloseClick"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
