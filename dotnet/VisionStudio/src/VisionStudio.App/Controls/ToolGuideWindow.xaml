<Window x:Class="VisionStudio.App.Controls.ToolGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:services="clr-namespace:VisionStudio.App.Services"
        mc:Ignorable="d"
        Title="VisionStudio - Cẩm Nang Hướng Dẫn Sử Dụng Công Cụ &amp; Thị Giác Máy"
        Height="720" Width="1080"
        MinHeight="550" MinWidth="800"
        Background="{StaticResource KsBgBase}" Foreground="{StaticResource KsText}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="TabPillStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource KsTextMuted}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder"
                                Background="{StaticResource KsBgSurface}"
                                BorderBrush="{StaticResource KsBorder}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,6"
                                Margin="0,0,4,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource KsBgCardHover}"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource KsAccent}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource KsBorderAccent}"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="50"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📖 " FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="CẨM NANG HƯỚNG DẪN SỬ DỤNG VISIONSTUDIO" FontWeight="Bold" FontSize="14" Foreground="{StaticResource KsAccentGlow}" VerticalAlignment="Center"/>
                    <TextBlock Text=" | Hướng Dẫn Chi Tiết Toàn Bộ Chức Năng &amp; Công Cụ Thị Giác Máy" Foreground="{StaticResource KsTextDim}" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                <!-- Language Toggle Button in Help Window -->
                <Button Grid.Column="1" Style="{StaticResource KsButton}" Click="OnToggleLanguageClick"
                        Content="{Binding SwitchLanguageButtonText, Source={x:Static services:LocalizationService.Instance}}"/>
            </Grid>
        </Border>

        <!-- MAIN SPLIT VIEW -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <!-- Left: Tool Navigation List -->
                <ColumnDefinition Width="300" MinWidth="240"/>
                <!-- Splitter -->
                <ColumnDefinition Width="6"/>
                <!-- Right: Detailed Documentation Card -->
                <ColumnDefinition Width="*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT TOOL LIST -->
            <Border Grid.Column="0" Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Category Toggle -->
                    <UniformGrid Grid.Row="0" Columns="2" Margin="0,0,0,10">
                        <RadioButton x:Name="TabSystemModules" Content="📁 Hệ Thống (15)" IsChecked="True"
                                     Style="{StaticResource TabPillStyle}" Click="OnCategoryTabChanged"/>
                        <RadioButton x:Name="TabVisionTools" Content="🔬 Công Cụ (40+)"
                                     Style="{StaticResource TabPillStyle}" Click="OnCategoryTabChanged"/>
                    </UniformGrid>

                    <!-- Search Filter Box -->
                    <Border Grid.Row="1" Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="{StaticResource KsTextDim}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1" TextChanged="OnSearchTextChanged"
                                     Background="Transparent" Foreground="{StaticResource KsText}" BorderThickness="0" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Tools List -->
                    <ListBox x:Name="ToolsList" Grid.Row="2" Background="{StaticResource KsBgBase}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1"
                             SelectionChanged="OnToolSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,2">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource KsText}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource KsAccentGlow}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

            <!-- RIGHT DETAILED GUIDE VIEW -->
            <Border Grid.Column="2" Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="GuideDetailsPanel">
                        <!-- Tool Header -->
                        <Border Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock x:Name="DocTitleText" Text="Tên công cụ" FontWeight="Bold" FontSize="18" Foreground="{StaticResource KsAccentGlow}"/>
                                <TextBlock x:Name="DocCategoryText" Text="Danh mục: " Foreground="{StaticResource KsTextMuted}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Section 1: Principle & Purpose -->
                        <Border Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="📖 1. Mục đích &amp; Nguyên lý hoạt động" FontWeight="Bold" FontSize="13" Foreground="{StaticResource KsText}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="DocPrincipleText" Foreground="{StaticResource KsTextMuted}" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                            </StackPanel>
                        </Border>

                        <!-- Section 2: Ports / UI Controls -->
                        <Border Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="Sec2Header" Text="🔌 2. Nút bấm, Cổng kết nối &amp; Giao diện" FontWeight="Bold" FontSize="13" Foreground="{StaticResource KsText}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="DocPortsText" Foreground="{StaticResource KsAccentGlow}" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                            </StackPanel>
                        </Border>

                        <!-- Section 3: Step-by-Step Instructions & Parameters Guide -->
                        <Border Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="Sec3Header" Text="⚙️ 3. Hướng dẫn từng bước thao tác &amp; Tham số" FontWeight="Bold" FontSize="13" Foreground="{StaticResource KsText}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="DocParametersText" Foreground="{StaticResource KsTextMuted}" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                            </StackPanel>
                        </Border>

                        <!-- Section 4: Industrial Use Cases -->
                        <Border Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="🏭 4. Ứng dụng thực tế trong nhà xưởng tự động hóa" FontWeight="Bold" FontSize="13" Foreground="{StaticResource KsText}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="DocUseCasesText" Foreground="{StaticResource KsSuccess}" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                            </StackPanel>
                        </Border>

                        <!-- Section 5: Quick Tips -->
                        <Border Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorderAccent}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="⚡ 5. Mẹo thao tác nhanh &amp; Lưu ý kỹ thuật" FontWeight="Bold" FontSize="13" Foreground="{StaticResource KsAccentGlow}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="DocTipsText" Foreground="{StaticResource KsText}" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                            </StackPanel>
                        </Border>

                        <!-- Section 6: Architecture / Schematic Diagram -->
                        <Border x:Name="DiagramBorder" Background="#0A0E17" BorderBrush="{StaticResource KsBorderAccent}" BorderThickness="1" CornerRadius="6" Padding="14">
                            <StackPanel>
                                <TextBlock Text="📐 6. Sơ đồ quy trình &amp; Kiến trúc trực quan" FontWeight="Bold" FontSize="13" Foreground="{StaticResource KsAccentGlow}" Margin="0,0,0,8"/>
                                <TextBox x:Name="DocDiagramText" FontFamily="Consolas" FontSize="11" Foreground="#38BDF8" Background="Transparent" BorderThickness="0" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
