<UserControl x:Class="VisionStudio.App.Controls.ImageViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:VisionStudio.App.Controls"
             xmlns:vm="clr-namespace:VisionStudio.App.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="850"
             Background="{StaticResource KsBgBase}">

    <Grid ClipToBounds="True">
        <!-- Interactive Viewport Canvas -->
        <Border x:Name="ViewportBorder" Background="{StaticResource KsBgBase}"
                ClipToBounds="True"
                MouseWheel="OnViewportMouseWheel"
                MouseDown="OnViewportMouseDown"
                MouseMove="OnViewportMouseMove"
                MouseUp="OnViewportMouseUp">

            <!-- Transformable Content Container -->
            <Canvas x:Name="TransformCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Canvas.RenderTransform>
                    <MatrixTransform x:Name="CanvasTransform"/>
                </Canvas.RenderTransform>

                <!-- Checkerboard / Background border backing -->
                <Border x:Name="ImageContainer" Canvas.Left="0" Canvas.Top="0" Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1">
                    <Grid>
                        <Image x:Name="MainImage"
                               Source="{Binding DisplayedImage}"
                               Stretch="None"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               RenderOptions.EdgeMode="Aliased"/>

                        <!-- Vector Overlay Canvas Host -->
                        <controls:DrawingVisualHost x:Name="OverlayHost"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"/>

                        <!-- Live Rubberband Drawing Surface (Image-coordinate aligned) -->
                        <Canvas x:Name="RubberbandCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False">
                            <!-- Box ROI Preview Rectangle -->
                            <Rectangle x:Name="RoiPreviewRect"
                                       Stroke="#00ffff" StrokeThickness="2" StrokeDashArray="4 2"
                                       Fill="#3300ffff" Visibility="Collapsed"/>

                            <!-- Line Caliper Preview -->
                            <Line x:Name="LinePreviewCaliper"
                                  Stroke="#39ff14" StrokeThickness="2.5" Visibility="Collapsed"/>
                            <Ellipse x:Name="LineStartMarker" Width="8" Height="8"
                                     Fill="#00ffff" Stroke="#ffffff" StrokeThickness="1.5" Visibility="Collapsed"/>
                            <Ellipse x:Name="LineEndMarker" Width="8" Height="8"
                                     Fill="#ff007f" Stroke="#ffffff" StrokeThickness="1.5" Visibility="Collapsed"/>

                            <!-- Point Picker Reticle Preview -->
                            <Ellipse x:Name="PointReticleCircle" Width="20" Height="20"
                                     Stroke="#ffaa00" StrokeThickness="2" Visibility="Collapsed"/>
                            <Line x:Name="PointReticleH" Stroke="#ffaa00" StrokeThickness="1.5" Visibility="Collapsed"/>
                            <Line x:Name="PointReticleV" Stroke="#ffaa00" StrokeThickness="1.5" Visibility="Collapsed"/>

                            <!-- Polygon Preview -->
                            <Polygon x:Name="PolygonPreview"
                                     Stroke="#ff00ff" StrokeThickness="2" StrokeDashArray="3 1"
                                     Fill="#25ff00ff" Visibility="Collapsed"/>

                            <!-- Dimension & Coordinate Floating Badge -->
                            <Border x:Name="DimensionBadge"
                                    Background="#ee111827" BorderBrush="#00ffff" BorderThickness="1" CornerRadius="4"
                                    Padding="6,3" Visibility="Collapsed">
                                <TextBlock x:Name="DimensionBadgeText" Text="ROI" Foreground="#00ffff"
                                           FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </Canvas>
                    </Grid>
                </Border>
            </Canvas>
        </Border>

        <!-- Top Floating Controls Header -->
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Top"
                Background="#ea18181b" BorderBrush="{StaticResource KsBorder}" BorderThickness="0,0,0,1"
                Padding="12,7" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Node Title & Image Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="🖼" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DisplayedTitle}" FontWeight="SemiBold" Foreground="{StaticResource KsAccentGlow}" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="|" Foreground="{StaticResource KsTextDim}" Margin="8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DisplayedImageInfo}" Foreground="{StaticResource KsTextMuted}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center: Interactive Selection Toolbar (Pan, Box ROI, Caliper Line, Point, Polygon) -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#222226" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="6" Padding="4,2">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="ToolPanBtn" Content="✋ Di chuyển" ToolTip="Di chuyển &amp; Phóng to ảnh (Pan/Zoom)"
                                     IsChecked="True" Checked="OnInteractiveToolChanged"
                                     Style="{StaticResource TabPillStyle}" Padding="8,4" FontSize="11"/>
                        <RadioButton x:Name="ToolRoiBtn" Content="🔲 Vùng ROI" ToolTip="Kéo chuột trên ảnh để đặt vùng chọn ROI chữ nhật"
                                     Checked="OnInteractiveToolChanged"
                                     Style="{StaticResource TabPillStyle}" Padding="8,4" FontSize="11"/>
                        <RadioButton x:Name="ToolLineBtn" Content="📏 Thước Caliper" ToolTip="Kéo đoạn thẳng trên ảnh để đặt vạch đo kích thước Caliper"
                                     Checked="OnInteractiveToolChanged"
                                     Style="{StaticResource TabPillStyle}" Padding="8,4" FontSize="11"/>
                        <RadioButton x:Name="ToolPointBtn" Content="🎯 Chọn điểm" ToolTip="Bấm chuột trên ảnh để chọn tọa độ tâm hoặc điểm kiểm tra"
                                     Checked="OnInteractiveToolChanged"
                                     Style="{StaticResource TabPillStyle}" Padding="8,4" FontSize="11"/>
                        <RadioButton x:Name="ToolPolygonBtn" Content="⬡ Đa giác" ToolTip="Bấm các điểm để tạo vùng đa giác, nhấp đúp để hoàn tất"
                                     Checked="OnInteractiveToolChanged"
                                     Style="{StaticResource TabPillStyle}" Padding="8,4" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Right: Zoom & Viewport Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📂 Nạp ảnh..." Command="{Binding ImportTestImageCommand}" ToolTip="Nạp ảnh từ máy tính để thử nghiệm Pipeline / Load Test Image"
                            Style="{StaticResource KsPrimaryButton}" Padding="10,3" Margin="0,0,8,0" FontSize="11"/>
                    <Button Content="Fit" Click="OnFitClick" ToolTip="Fit Image to Window"
                            Style="{StaticResource KsButton}" Padding="8,3" Margin="0,0,4,0" FontSize="11"/>
                    <Button Content="1:1" Click="OnActualSizeClick" ToolTip="Actual Size (100%)"
                            Style="{StaticResource KsButton}" Padding="8,3" Margin="0,0,4,0" FontSize="11"/>
                    <Button Content="−" Click="OnZoomOutClick" ToolTip="Zoom Out"
                            Style="{StaticResource KsButton}" Padding="8,3" Margin="0,0,4,0" FontSize="11"/>
                    <TextBlock x:Name="ZoomText" Text="100%" Foreground="{StaticResource KsAccentGlow}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="4,0,8,0"/>
                    <Button Content="+" Click="OnZoomInClick" ToolTip="Zoom In"
                            Style="{StaticResource KsButton}" Padding="8,3" Margin="0,0,8,0" FontSize="11"/>
                    <CheckBox x:Name="ShowOverlaysCheck" Content="Overlays" IsChecked="True" Checked="OnOverlaysCheckChanged" Unchecked="OnOverlaysCheckChanged"
                              Foreground="{StaticResource KsTextMuted}" VerticalAlignment="Center" FontSize="11" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bottom Left: Interactive Status & Hints Bar -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Background="#ea18181b" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="6"
                Padding="10,5" Margin="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.4" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚡ " FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding InteractiveStatusHint}" Foreground="{StaticResource KsText}" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Bottom Right: Floating Pixel Inspection Readout -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Background="#ea18181b" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="6"
                Padding="10,5" Margin="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.4" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🎯 " FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CursorPixelInfo}" Foreground="{StaticResource KsAccentGlow}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
