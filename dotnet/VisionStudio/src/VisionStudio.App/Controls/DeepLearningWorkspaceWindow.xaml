<Window x:Class="VisionStudio.App.Controls.DeepLearningWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Deep Learning Industrial Workspace - Không Gian Huấn Luyện AI Công Nghiệp"
        Height="880" Width="1380"
        MinHeight="680" MinWidth="1050"
        Background="{StaticResource KsBgBase}" Foreground="{StaticResource KsText}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="50"/>
            <!-- Main Content Tabs -->
            <RowDefinition Height="*"/>
            <!-- Status Bar -->
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🧠 " FontSize="20" VerticalAlignment="Center"/>
                    <TextBlock Text="DEEP LEARNING WORKSPACE" FontWeight="Bold" FontSize="14" Foreground="{StaticResource KsAccentGlow}" VerticalAlignment="Center"/>
                    <TextBlock Text=" | Dataset Manager, Labeling, PatchCore / Classifier Trainer &amp; Model Registry" Foreground="{StaticResource KsTextDim}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnExportModel" Content="💾 Xuất Gói (.vsmodel)" Click="BtnExportModel_Click"
                            Style="{StaticResource KsSecondaryButton}" Margin="0,0,8,0" Padding="12,5"/>
                    <Button x:Name="BtnApplyToPipeline" Content="🚀 Nạp Vào Pipeline" Click="BtnApplyToPipeline_Click"
                            Style="{StaticResource KsPrimaryButton}" Padding="14,5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN TABBED INTERFACE -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="10,6,10,6">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="{StaticResource KsBgCard}"/>
                    <Setter Property="Foreground" Value="{StaticResource KsText}"/>
                    <Setter Property="Padding" Value="14,8"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="BorderThickness" Value="1,1,1,0"/>
                    <Setter Property="BorderBrush" Value="{StaticResource KsBorder}"/>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: DATASET & LABELING -->
            <TabItem Header="📁 Quản Lý Dữ Liệu &amp; Gán Nhãn (Dataset)">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" MinWidth="320"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*" MinWidth="500"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Dataset Operations & Stats -->
                    <Border Grid.Column="0" Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="THAO TÁC DATASET" FontWeight="Bold" FontSize="12" Foreground="{StaticResource KsAccentGlow}" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnImportFolder" Content="📂 Nhập Thư Mục Ảnh..." Click="BtnImportFolder_Click"
                                            Style="{StaticResource KsPrimaryButton}" Padding="10,6" Margin="0,0,6,0"/>
                                    <Button Grid.Column="1" x:Name="BtnAddSynthetic" Content="✨ Mẫu Thử Nghiệm" Click="BtnAddSynthetic_Click"
                                            Style="{StaticResource KsSecondaryButton}" Padding="10,6"/>
                                </Grid>

                                <Button x:Name="BtnScanDuplicates" Content="🔍 Quét Ảnh Trùng Lặp (SHA-256)" Click="BtnScanDuplicates_Click"
                                        Style="{StaticResource KsSecondaryButton}" Padding="10,6" Margin="0,0,0,12"/>

                                <!-- SPLIT CONTROLS -->
                                <Border Background="{StaticResource KsBgSurface}" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="PHÂN CHIA TẬP DỮ LIỆU (STRATIFIED SPLIT)" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource KsTextDim}" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Train: 70%" FontSize="11" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Val: 15%" FontSize="11" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="Test: 15%" FontSize="11" HorizontalAlignment="Center"/>
                                        </Grid>
                                        <Button x:Name="BtnStratifiedSplit" Content="⚖️ Phân Tách Cân Bằng (Split)" Click="BtnStratifiedSplit_Click"
                                                Style="{StaticResource KsSecondaryButton}" Padding="8,4" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- DATASET STATS -->
                                <TextBlock Text="THỐNG KÊ PHÂN BỐ LỚP" FontWeight="Bold" FontSize="12" Foreground="{StaticResource KsAccentGlow}" Margin="0,0,0,8"/>
                                <DataGrid x:Name="GridClassStats" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                          Background="Transparent" BorderBrush="{StaticResource KsBorder}" BorderThickness="1"
                                          RowBackground="{StaticResource KsBgSurface}" AlternatingRowBackground="{StaticResource KsBgCard}"
                                          MaxHeight="150" Margin="0,0,0,12">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Nhãn (Class)" Binding="{Binding Label}" Width="*"/>
                                        <DataGridTextColumn Header="Tổng" Binding="{Binding TotalCount}" Width="50"/>
                                        <DataGridTextColumn Header="Train" Binding="{Binding TrainCount}" Width="50"/>
                                        <DataGridTextColumn Header="Val" Binding="{Binding ValCount}" Width="45"/>
                                        <DataGridTextColumn Header="Test" Binding="{Binding TestCount}" Width="45"/>
                                        <DataGridTextColumn Header="%" Binding="{Binding Percentage}" Width="45"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- VERSION HASH -->
                                <TextBlock Text="MÃ BĂM PHIÊN BẢN (DATASET HASH)" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource KsTextDim}"/>
                                <TextBox x:Name="TxtDatasetHash" IsReadOnly="True" Background="{StaticResource KsBgSurface}" Foreground="{StaticResource KsAccentGlow}"
                                         BorderBrush="{StaticResource KsBorder}" Padding="6,4" Margin="0,4,0,0" FontSize="11" Text="sha256:none"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent"/>

                    <!-- Right: Item List & Canvas Viewer -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="180" MinHeight="120"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Item List DataGrid -->
                        <Border Grid.Row="0" Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="DANH SÁCH MẪU ẢNH TRONG DATASET" FontWeight="Bold" FontSize="12" Foreground="{StaticResource KsAccentGlow}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="Đổi nhãn thành: " VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource KsTextDim}"/>
                                        <TextBox x:Name="TxtQuickLabel" Width="80" Text="good" Padding="4,2" Margin="4,0,6,0"/>
                                        <Button x:Name="BtnApplyLabel" Content="Gán" Click="BtnApplyLabel_Click" Style="{StaticResource KsSecondaryButton}" Padding="8,2"/>
                                    </StackPanel>
                                </Grid>

                                <DataGrid Grid.Row="1" x:Name="GridDatasetItems" AutoGenerateColumns="False" IsReadOnly="True"
                                          SelectionChanged="GridDatasetItems_SelectionChanged"
                                          Background="Transparent" BorderBrush="{StaticResource KsBorder}" BorderThickness="1"
                                          RowBackground="{StaticResource KsBgSurface}" AlternatingRowBackground="{StaticResource KsBgCard}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tệp" Binding="{Binding FilePath}" Width="*"/>
                                        <DataGridTextColumn Header="Nhãn (Label)" Binding="{Binding PrimaryLabel}" Width="100"/>
                                        <DataGridTextColumn Header="Tập (Split)" Binding="{Binding Split}" Width="80"/>
                                        <DataGridTextColumn Header="Kích Thước" Binding="{Binding Width}" Width="70"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Row="1" Height="6" VerticalAlignment="Center" Background="Transparent"/>

                        <!-- Image Preview Canvas -->
                        <Border Grid.Row="2" Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                            <Grid>
                                <Image x:Name="ImgItemPreview" Stretch="Uniform"/>
                                <TextBlock x:Name="TxtNoItem" Text="Chọn một ảnh trong danh sách để xem trước" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource KsTextDim}" FontSize="13"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 2: TRAINING ENGINE & SIDECAR -->
            <TabItem Header="⚡ Huấn Luyện Mô Hình (Training Engine)">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" MinWidth="350"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*" MinWidth="500"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Hyperparameters & Launcher -->
                    <Border Grid.Column="0" Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="CẤU HÌNH HUẤN LUYỆN (HYPERPARAMETERS)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource KsAccentGlow}" Margin="0,0,0,12"/>

                                <TextBlock Text="Tên mô hình:" FontSize="11" Foreground="{StaticResource KsTextDim}"/>
                                <TextBox x:Name="TxtModelName" Text="IndustrialPatchCoreDetector" Background="{StaticResource KsBgSurface}" Padding="6,4" Margin="0,2,0,10"/>

                                <TextBlock Text="Loại tác vụ (Task Type):" FontSize="11" Foreground="{StaticResource KsTextDim}"/>
                                <ComboBox x:Name="CmbTaskType" SelectedIndex="0" Background="{StaticResource KsBgSurface}" Padding="6,4" Margin="0,2,0,10">
                                    <ComboBoxItem Content="Phát hiện dị vật / khuyết tật (Anomaly Detection - PatchCore)"/>
                                    <ComboBoxItem Content="Phân loại ngoại quan (Classification)"/>
                                    <ComboBoxItem Content="Định vị đối tượng (Object Detection)"/>
                                    <ComboBoxItem Content="Phân đoạn đối tượng (Instance Segmentation)"/>
                                    <ComboBoxItem Content="Đọc ký tự quang học (Deep OCR)"/>
                                </ComboBox>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Độ rộng (Width):" FontSize="11" Foreground="{StaticResource KsTextDim}"/>
                                        <TextBox x:Name="TxtInputWidth" Text="64" Background="{StaticResource KsBgSurface}" Padding="6,4" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Độ cao (Height):" FontSize="11" Foreground="{StaticResource KsTextDim}"/>
                                        <TextBox x:Name="TxtInputHeight" Text="64" Background="{StaticResource KsBgSurface}" Padding="6,4" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Số Epochs:" FontSize="11" Foreground="{StaticResource KsTextDim}"/>
                                        <TextBox x:Name="TxtEpochs" Text="10" Background="{StaticResource KsBgSurface}" Padding="6,4" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Learning Rate:" FontSize="11" Foreground="{StaticResource KsTextDim}"/>
                                        <TextBox x:Name="TxtLearningRate" Text="0.01" Background="{StaticResource KsBgSurface}" Padding="6,4" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Cơ chế thực thi (Training Engine):" FontSize="11" Foreground="{StaticResource KsTextDim}"/>
                                <ComboBox x:Name="CmbEngineType" SelectedIndex="0" Background="{StaticResource KsBgSurface}" Padding="6,4" Margin="0,2,0,14">
                                    <ComboBoxItem Content="⚡ C# High-Speed Engine (Không cần Python/GPU, cực nhanh)"/>
                                    <ComboBoxItem Content="🐍 External Python Sidecar Process (PyTorch / GPU)"/>
                                </ComboBox>

                                <StackPanel x:Name="PnlPythonOptions" Visibility="Collapsed" Margin="0,0,0,12">
                                    <TextBlock Text="Tệp mã Python Script (.py):" FontSize="11" Foreground="{StaticResource KsTextDim}"/>
                                    <TextBox x:Name="TxtPythonScript" Text="" Background="{StaticResource KsBgSurface}" Padding="6,4" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Launch Buttons -->
                                <Button x:Name="BtnStartTraining" Content="🚀 BẮT ĐẦU HUẤN LUYỆN (START TRAINING)" Click="BtnStartTraining_Click"
                                        Style="{StaticResource KsSuccessButton}" Padding="14,10" FontWeight="Bold" Margin="0,0,0,8"/>
                                <Button x:Name="BtnCancelTraining" Content="⏹️ Hủy Huấn Luyện" Click="BtnCancelTraining_Click"
                                        IsEnabled="False" Style="{StaticResource KsDangerButton}" Padding="12,6"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent"/>

                    <!-- Right: Live Progress & Logs -->
                    <Border Grid.Column="2" Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Progress Bars -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                                <TextBlock Text="TIẾN ĐỘ THỰC THI THỜI GIAN THỰC" FontWeight="Bold" FontSize="12" Foreground="{StaticResource KsAccentGlow}" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtProgressMessage" Text="Sẵn sàng khởi động huấn luyện..." FontSize="12"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtProgressPercent" Text="0%" FontWeight="Bold" Foreground="{StaticResource KsAccentGlow}"/>
                                </Grid>
                                <ProgressBar x:Name="PbTraining" Height="14" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource KsAccentGlow}" Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}"/>
                            </StackPanel>

                            <!-- Live Metric Badges -->
                            <Border Grid.Row="1" Background="{StaticResource KsBgSurface}" CornerRadius="6" Padding="10" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="EPOCH HIỆN TẠI" FontSize="10" Foreground="{StaticResource KsTextDim}"/>
                                        <TextBlock x:Name="TxtEpochBadge" Text="0 / 0" FontSize="16" FontWeight="Bold" Foreground="{StaticResource KsText}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="LOSS" FontSize="10" Foreground="{StaticResource KsTextDim}"/>
                                        <TextBlock x:Name="TxtLossBadge" Text="0.0000" FontSize="16" FontWeight="Bold" Foreground="{StaticResource KsWarning}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Text="VAL METRIC (F1 / AUROC)" FontSize="10" Foreground="{StaticResource KsTextDim}"/>
                                        <TextBlock x:Name="TxtMetricBadge" Text="0.0%" FontSize="16" FontWeight="Bold" Foreground="{StaticResource KsSuccess}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Console Output -->
                            <Border Grid.Row="2" Background="{StaticResource KsBgBase}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="6" Padding="8">
                                <TextBox x:Name="TxtConsoleLog" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         Background="Transparent" Foreground="#A0FFA0" FontFamily="Consolas" FontSize="11" BorderThickness="0"
                                         Text="[Training Host Initialized. Ready for dataset processing.]&#x0a;"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: EVALUATION & CONFUSION MATRIX -->
            <TabItem Header="📊 Đánh Giá &amp; Ma Trận (Evaluation)">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" MinWidth="320"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*" MinWidth="480"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Metrics Overview -->
                    <Border Grid.Column="0" Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="KẾT QUẢ ĐÁNH GIÁ MÔ HÌNH" FontWeight="Bold" FontSize="12" Foreground="{StaticResource KsAccentGlow}" Margin="0,0,0,12"/>

                            <!-- Metric Cards -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource KsBgSurface}" CornerRadius="6" Padding="10">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="AUROC (ANOMALY)" FontSize="10" Foreground="{StaticResource KsTextDim}"/>
                                        <TextBlock x:Name="TxtEvalAuroc" Text="N/A" FontSize="20" FontWeight="Bold" Foreground="{StaticResource KsAccentGlow}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{StaticResource KsBgSurface}" CornerRadius="6" Padding="10">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="ĐỘ CHÍNH XÁC (ACC)" FontSize="10" Foreground="{StaticResource KsTextDim}"/>
                                        <TextBlock x:Name="TxtEvalAcc" Text="N/A" FontSize="20" FontWeight="Bold" Foreground="{StaticResource KsSuccess}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource KsBgSurface}" CornerRadius="6" Padding="10">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="ĐIỂM MACRO F1" FontSize="10" Foreground="{StaticResource KsTextDim}"/>
                                        <TextBlock x:Name="TxtEvalF1" Text="N/A" FontSize="20" FontWeight="Bold" Foreground="{StaticResource KsWarning}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{StaticResource KsBgSurface}" CornerRadius="6" Padding="10">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="NGƯỠNG TỐI ƯU" FontSize="10" Foreground="{StaticResource KsTextDim}"/>
                                        <TextBlock x:Name="TxtEvalThreshold" Text="0.500" FontSize="20" FontWeight="Bold" Foreground="{StaticResource KsText}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Text="BẢNG CHỈ SỐ THEO TỪNG LỚP (PER-CLASS BREAKDOWN)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource KsTextDim}" Margin="0,0,0,6"/>
                            <DataGrid x:Name="GridPerClassMetrics" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="Transparent" BorderBrush="{StaticResource KsBorder}" BorderThickness="1"
                                      RowBackground="{StaticResource KsBgSurface}" AlternatingRowBackground="{StaticResource KsBgCard}" Height="200">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Lớp" Binding="{Binding ClassName}" Width="*"/>
                                    <DataGridTextColumn Header="Precision" Binding="{Binding Precision}" Width="80"/>
                                    <DataGridTextColumn Header="Recall" Binding="{Binding Recall}" Width="80"/>
                                    <DataGridTextColumn Header="F1-Score" Binding="{Binding F1}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent"/>

                    <!-- Right: Confusion Matrix Visualizer -->
                    <Border Grid.Column="2" Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="MA TRẬN NHẦM LẪN (CONFUSION MATRIX [ACTUAL vs PREDICTED])" FontWeight="Bold" FontSize="12" Foreground="{StaticResource KsAccentGlow}" Margin="0,0,0,10"/>
                            <Border Grid.Row="1" Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="6" Padding="14">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <Grid x:Name="GridConfusionMatrix" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Dynamically generated confusion matrix cells in code-behind -->
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 4: MODEL REGISTRY & COMPARISON -->
            <TabItem Header="🏛️ Kho Mô Hình &amp; Phiên Bản (Registry)">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="220" MinHeight="150"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top: Registry List -->
                    <Border Grid.Row="0" Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="DANH MỤC MÔ HÌNH TRONG KHO (MODEL REGISTRY MANIFEST)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource KsAccentGlow}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="BtnPromoteProduction" Content="⭐ Thăng Cấp Thành Production" Click="BtnPromoteProduction_Click"
                                            Style="{StaticResource KsSuccessButton}" Padding="10,4" Margin="0,0,6,0"/>
                                    <Button x:Name="BtnRollbackProduction" Content="⏪ Khôi Phục Phiên Bản (Rollback)" Click="BtnRollbackProduction_Click"
                                            Style="{StaticResource KsSecondaryButton}" Padding="10,4" Margin="0,0,6,0"/>
                                    <Button x:Name="BtnCompareModels" Content="⚖️ So Sánh 2 Mô Hình" Click="BtnCompareModels_Click"
                                            Style="{StaticResource KsPrimaryButton}" Padding="10,4"/>
                                </StackPanel>
                            </Grid>

                            <DataGrid Grid.Row="1" x:Name="GridRegistryModels" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Extended"
                                      Background="Transparent" BorderBrush="{StaticResource KsBorder}" BorderThickness="1"
                                      RowBackground="{StaticResource KsBgSurface}" AlternatingRowBackground="{StaticResource KsBgCard}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tên Mô Hình" Binding="{Binding Name}" Width="160"/>
                                    <DataGridTextColumn Header="Phiên Bản" Binding="{Binding Version}" Width="80"/>
                                    <DataGridTextColumn Header="Tác Vụ (Task)" Binding="{Binding TaskType}" Width="130"/>
                                    <DataGridCheckBoxColumn Header="Production" Binding="{Binding IsProduction}" Width="80"/>
                                    <DataGridTextColumn Header="AUROC" Binding="{Binding Auroc, StringFormat='F3'}" Width="80"/>
                                    <DataGridTextColumn Header="F1" Binding="{Binding F1Score, StringFormat='F3'}" Width="80"/>
                                    <DataGridTextColumn Header="Độ trễ p50" Binding="{Binding LatencyP50Ms, StringFormat='{}{0:F1} ms'}" Width="90"/>
                                    <DataGridTextColumn Header="Dataset Hash" Binding="{Binding DatasetHash}" Width="120"/>
                                    <DataGridTextColumn Header="Ngày Tạo" Binding="{Binding CreatedAt, StringFormat='g'}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Row="1" Height="6" VerticalAlignment="Center" Background="Transparent"/>

                    <!-- Bottom: Comparison View -->
                    <Border Grid.Row="2" Background="{StaticResource KsBgCard}" BorderBrush="{StaticResource KsBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="SO SÁNH ĐỐI CHIẾU TRỰC TIẾP (SIDE-BY-SIDE MODEL COMPARISON)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource KsAccentGlow}" Margin="0,0,0,8"/>
                            <DataGrid Grid.Row="1" x:Name="GridModelComparison" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="Transparent" BorderBrush="{StaticResource KsBorder}" BorderThickness="1"
                                      RowBackground="{StaticResource KsBgSurface}" AlternatingRowBackground="{StaticResource KsBgCard}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Chỉ Số / Thuộc Tính" Binding="{Binding Property}" Width="220" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="Mô Hình A (Baseline)" Binding="{Binding ModelAValue}" Width="*"/>
                                    <DataGridTextColumn Header="Mô Hình B (Candidate)" Binding="{Binding ModelBValue}" Width="*"/>
                                    <DataGridTextColumn Header="Đánh Giá Ưu Thế" Binding="{Binding Winner}" Width="150" Foreground="{StaticResource KsAccentGlow}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="{StaticResource KsBgSurface}" BorderBrush="{StaticResource KsBorder}" BorderThickness="0,1,0,0" Padding="12,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Text="Sẵn sàng." FontSize="11" Foreground="{StaticResource KsTextDim}"/>
                <TextBlock Grid.Column="1" Text="VisionStudio Deep Learning Studio 2.0" FontSize="11" Foreground="{StaticResource KsTextDim}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
