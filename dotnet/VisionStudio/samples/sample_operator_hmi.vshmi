          "column": 4,
          "row": 0,
          "colSpan": 4,
          "rowSpan": 3,
          "minimumRole": "operator",
          "binding": {
            "source": "deviceTag",
            "path": "PLC.ConveyorSpeed",
            "format": "{0}",
            "invertBoolean": false
          },
          "properties": {}
        },
        {
          "id": "w-btn-reset",
          "type": "button",
          "title": "Đặt Lại Bộ Đếm Sản Lượng",
          "column": 8,
          "row": 0,
          "colSpan": 4,
          "rowSpan": 3,
          "minimumRole": "admin",
          "binding": null,
          "properties": {
