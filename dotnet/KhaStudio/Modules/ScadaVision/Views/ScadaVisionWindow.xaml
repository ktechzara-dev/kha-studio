<Window x:Class="KhaStudio.Modules.ScadaVision.Views.ScadaVisionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:KhaStudio.Modules.ScadaVision.ViewModels"
        xmlns:views="clr-namespace:KhaStudio.Modules.ScadaVision.Views"
        mc:Ignorable="d"
        Title="SCADA Graphics &amp; Machine Vision Toolkit — Kha Studio" 
        Height="850" Width="1350"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#0B1120" Foreground="#F1F5F9">

    <Window.DataContext>
        <vm:ScadaVisionMainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Modern Dark TabControl Styling -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="#334155" BorderThickness="0,0,1,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#0F172A"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Title Bar -->
        <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0284C7" Width="28" Height="28" CornerRadius="6" Margin="0,0,10,0">
                        <TextBlock Text="👁️" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                    </Border>
                    <TextBlock Text="SCADA Graphics &amp; Machine Vision Toolkit" FontWeight="Bold" FontSize="16" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                    <Border Background="#1E3A8A" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="C# WPF .NET 8 • OpenCV • Svg.Skia • ZXing" FontSize="10" FontWeight="SemiBold" Foreground="#93C5FD"/>
                    </Border>
                </StackPanel>

                <TextBlock Text="Kha Studio Industrial Engineering" DockPanel.Dock="Right" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Main Tab Control phân chia 2 khu vực rõ ràng -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">
            <!-- TAB 1: SCADA DESIGN TAB -->
            <TabItem Header="🎨 ScadaDesignTab (Symbol Manager &amp; ISA-101 Palette)">
                <views:ScadaDesignView DataContext="{Binding ScadaDesign}"/>
            </TabItem>

            <!-- TAB 2: VISION TEST TAB -->
            <TabItem Header="📷 VisionTestTab (OpenCV Sandbox &amp; Barcode / QR Scanner)">
                <views:VisionTestView DataContext="{Binding VisionTest}"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
