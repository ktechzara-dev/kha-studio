<UserControl x:Class="KhaStudio.Modules.ScadaVision.Views.VisionTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:KhaStudio.Modules.ScadaVision.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:VisionTestViewModel}"
             Background="#0F172A" Foreground="#F1F5F9">

    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <!-- THANH CÔNG CỤ ĐIỀU KHIỂN & SLIDER FILTERS -->
        <Border Grid.Row="0" Background="#182234" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Load Image Button -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Button Content="🖼️ Tải Ảnh Kiểm Tra" Command="{Binding LoadImageFileCommand}" Margin="0,0,8,0"/>
                </StackPanel>

                <!-- 3 Sliders: Threshold, Canny Min, Canny Max -->
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Slider 1: Threshold -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <DockPanel>
                            <TextBlock Text="Threshold (Nhị phân):" FontSize="11" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding ThresholdValue, StringFormat={}{0:F0}}" HorizontalAlignment="Right" Foreground="#38BDF8" FontWeight="Bold" FontFamily="Consolas"/>
                        </DockPanel>
                        <Slider Minimum="0" Maximum="255" Value="{Binding ThresholdValue, Mode=TwoWay}" SmallChange="1" LargeChange="10"/>
                    </StackPanel>

                    <!-- Slider 2: Canny Min -->
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <DockPanel>
                            <TextBlock Text="Canny Min (Ngưỡng dưới):" FontSize="11" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding CannyMin, StringFormat={}{0:F0}}" HorizontalAlignment="Right" Foreground="#F59E0B" FontWeight="Bold" FontFamily="Consolas"/>
                        </DockPanel>
                        <Slider Minimum="0" Maximum="255" Value="{Binding CannyMin, Mode=TwoWay}" SmallChange="1" LargeChange="10"/>
                    </StackPanel>

                    <!-- Slider 3: Canny Max -->
                    <StackPanel Grid.Column="2">
                        <DockPanel>
                            <TextBlock Text="Canny Max (Ngưỡng trên):" FontSize="11" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding CannyMax, StringFormat={}{0:F0}}" HorizontalAlignment="Right" Foreground="#EC4899" FontWeight="Bold" FontFamily="Consolas"/>
                        </DockPanel>
                        <Slider Minimum="0" Maximum="255" Value="{Binding CannyMax, Mode=TwoWay}" SmallChange="1" LargeChange="10"/>
                    </StackPanel>
                </Grid>

                <!-- USB Camera Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="Camera:" VerticalAlignment="Center" FontSize="11" Foreground="#94A3B8" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding CameraList}" SelectedItem="{Binding SelectedCamera}" Width="150" Margin="0,0,8,0"/>
                    <Button Content="{Binding IsCameraRunning, ConverterParameter='Dừng|Bắt đầu', Mode=OneWay}" 
                            Command="{Binding ToggleCameraCommand}"
                            Background="#0284C7" BorderBrush="#38BDF8">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="▶ Bật Camera"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCameraRunning}" Value="True">
                                        <Setter Property="Content" Value="⏹ Dừng Camera"/>
                                        <Setter Property="Background" Value="#DC2626"/>
                                        <Setter Property="BorderBrush" Value="#EF4444"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- KHU VỰC 2 IMAGE CONTROL: ORIGINAL VÀ FILTERED -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Image 1: Original Image -->
            <Border Grid.Column="0" Background="#182234" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,6,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="1. Ảnh gốc / Camera Trực tiếp (Original)" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" Margin="0,0,0,8"/>
                    <Border Background="#0B1120" BorderBrush="#334155" BorderThickness="1" CornerRadius="6">
                        <Image Source="{Binding OriginalImage}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Image 2: Filtered Image (OpenCV Gray -> Threshold -> Canny) -->
            <Border Grid.Column="1" Background="#182234" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10" Margin="6,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="2. Ảnh xử lý lọc cạnh biên (OpenCV Canny Edges)" FontWeight="Bold" FontSize="12" Foreground="#10B981" Margin="0,0,0,8"/>
                    <Border Background="#0B1120" BorderBrush="#334155" BorderThickness="1" CornerRadius="6">
                        <Image Source="{Binding FilteredImage}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <!-- KHU VỰC NHẬT KÝ QUÉT MÃ VẠCH / QR CODE (ZXing) -->
        <Border Grid.Row="2" Background="#182234" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="Nhật ký Quét mã vạch / QR Code công nghiệp (ZXing Barcode Reader)" FontWeight="Bold" FontSize="12" Foreground="#A78BFA"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#10B981" FontSize="11" HorizontalAlignment="Right"/>
                </DockPanel>

                <ListBox ItemsSource="{Binding ScanLogs}" Background="#0B1120" BorderBrush="#334155" Foreground="#E2E8F0"
                         FontFamily="Consolas" FontSize="11">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="#34D399" Padding="4,2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
